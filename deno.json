{
	"imports": {
		"acorn": "npm:acorn@8.15.0",
		"svelte/compiler": "npm:svelte@5.45.8/compiler",
		"@sveltejs/acorn-typescript": "npm:@sveltejs/acorn-typescript@1.0.8",
		"prettier": "npm:prettier@3.7.4",
		"prettier-plugin-svelte": "npm:prettier-plugin-svelte@3.4.0"
	},
	"tasks": {
		"build": "cargo build --workspace",
		"build:release": "cargo build --workspace --release",
		"build:ffi": "cargo build -p tsv_ffi --release",
		"build:wasm": "wasm-pack build crates/tsv_wasm --target deno --release",
		"build:all": "deno task build:release && deno task build:ffi && deno task build:wasm",
		"clean": "cargo clean",

		"dev": "cargo watch -x 'check --workspace' -x 'test --workspace' || echo '⚠️  cargo-watch not installed. Run: cargo install cargo-watch'",
		"typecheck": "cargo check --workspace",
		"test": "cargo test --workspace",
		"lint": "cargo clippy --workspace",
		"check": "deno task typecheck && deno task test && deno task lint && deno fmt --check",
		"format": "cargo fmt && deno fmt",

		"fixtures:list": "cargo run -p tsv_debug --quiet fixtures_update_parsed --list",
		"fixtures:validate": "cargo run -p tsv_debug --quiet fixtures_validate",
		"fixtures:update": "cargo run -p tsv_debug --quiet fixtures_update",
		"fixtures:update:parsed": "cargo run -p tsv_debug --quiet fixtures_update_parsed",
		"fixtures:update:formatted": "cargo run -p tsv_debug --quiet fixtures_update_formatted",

		"bench": "deno task build:ffi && deno task build:wasm && deno task bench:run",
		"bench:run": "deno bench --allow-ffi --allow-read --allow-env --allow-net --allow-sys benches/deno/"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 100,
		"singleQuote": true,
		"proseWrap": "preserve"
	},
	"exclude": ["node_modules", "target", "tests/fixtures", ".claude"]
}
