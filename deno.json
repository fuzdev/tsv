{
	"tasks": {
		"build": "cargo build --workspace",
		"build_release": "cargo build --workspace --release",
		"clean": "cargo clean",
		"dev": "cargo watch -x 'check --workspace' -x 'test --workspace' || echo '⚠️  cargo-watch not installed. Run: cargo install cargo-watch'",
		"check": "cargo check --workspace && cargo test --workspace && cargo clippy --workspace && deno fmt --check",
		"format": "cargo fmt && deno fmt",
		"fixtures_update": "cargo run -p tsv_debug --quiet fixtures_update",
		"fixtures_update_parsed": "cargo run -p tsv_debug --quiet fixtures_update_parsed",
		"fixtures_update_formatted": "cargo run -p tsv_debug --quiet fixtures_update_formatted",
		"fixtures_validate": "cargo run -p tsv_debug --quiet fixtures_validate",
		"fixtures_list": "cargo run -p tsv_debug --quiet fixtures_update_parsed --list",
		"debug_compare": "cargo run -p tsv_debug --quiet compare",
		"bench:build:ffi": "cargo build -p tsv_ffi --release",
		"bench:build:wasm": "wasm-pack build crates/tsv_wasm --target deno --release",
		"bench:build": "deno task bench:build:ffi && deno task bench:build:wasm",
		"bench:run": "deno bench --allow-ffi --allow-read --allow-env --allow-net --allow-sys benches/deno/",
		"bench": "deno task bench:build && deno task bench:run"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 100,
		"singleQuote": true,
		"proseWrap": "preserve"
	},
	"exclude": ["node_modules", "target", "tests/fixtures", ".claude"]
}
