			{
				"type": "Comment",
				"start": 0,
				"end": 413,
				"data": "\n\tAn INTERIOR newline in a hugged inline element selects its layout only when the content is\n\tnot a reflowable fill. A run holding a single word has no fill to reflow into, so its\n\twhitespace-only newline is the author's structure and the element expands, boundaries and\n\tall; the same newline in a run that is prose — its text carries two words — is the\n\tfill's own wrap point, and the element collapses.\n"
			},
			{
				"type": "Text",
				"start": 413,
				"end": 415,
				"raw": "\n\n",
				"data": "\n\n"
			},
