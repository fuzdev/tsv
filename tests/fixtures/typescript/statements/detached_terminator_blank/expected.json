	"comments": [
		{
			"type": "Line",
			"value": " A blank line a statement's own terminator sits below belongs to the statement,",
			"start": 20,
			"end": 101
		},
		{
			"type": "Line",
			"value": " so it survives the `;` moving back up to the content it terminates.",
			"start": 103,
			"end": 173
		},
		{
			"type": "Line",
			"value": " Every kind measured from its content end rather than its full end.",
			"start": 191,
			"end": 260
		},
		{
			"type": "Line",
			"value": " A header kind is measured through its body, so the rule reaches the body's own",
			"start": 437,
			"end": 518
		},
		{
			"type": "Line",
			"value": " terminator.",
			"start": 520,
			"end": 534
		},
		{
			"type": "Line",
			"value": " A kind the table does not list is measured from its full end, so a blank above",
			"start": 947,
			"end": 1028
		},
		{
			"type": "Line",
			"value": " its terminator stays inside the statement and never reaches the gap.",
			"start": 1030,
			"end": 1101
		},
		{
			"type": "Line",
			"value": " A header whose body IS the terminator is measured through that empty statement,",
			"start": 1126,
			"end": 1208
		},
		{
			"type": "Line",
			"value": " which the table does not list either.",
			"start": 1210,
			"end": 1250
		},
		{
			"type": "Line",
			"value": " A terminator on the next line with no blank above it gains none.",
			"start": 1304,
			"end": 1371
		},
		{
			"type": "Line",
			"value": " A comment the author trailed on the content's own line is skipped the way",
			"start": 1390,
			"end": 1466
		},
		{
			"type": "Line",
			"value": " prettier's own scan skips it, so the blank below it still reaches the gap.",
			"start": 1468,
			"end": 1545
		},
		{
			"type": "Line",
			"value": " c1",
			"start": 1554,
			"end": 1559
		},
		{
			"type": "Block",
			"value": " c2 ",
			"start": 1569,
			"end": 1577
		},
		{
			"type": "Line",
			"value": " A comment sitting BELOW the blank owns that blank itself, and a comment between",
			"start": 1589,
			"end": 1671
		},
		{
			"type": "Line",
			"value": " the content and its terminator leaves the question to the terminator's own end.",
			"start": 1673,
			"end": 1755
		},
		{
			"type": "Line",
			"value": " c3",
			"start": 1766,
			"end": 1771
		},
		{
			"type": "Block",
			"value": " c4 ",
			"start": 1780,
			"end": 1788
		},
		{
			"type": "Line",
			"value": " Block body, switch consequent and namespace body take the same rule.",
			"start": 1800,
			"end": 1871
		},
		{
			"type": "Line",
			"value": " A case LABEL gap is measured from the SwitchCase, a kind the table does not list, so a",
			"start": 1990,
			"end": 2079
		},
		{
			"type": "Line",
			"value": " blank above a detached terminator stays inside the consequent and never reaches it.",
			"start": 2081,
			"end": 2167
		},
		{
			"type": "Line",
			"value": " The null control for that gap: a blank the author wrote BELOW the terminator is the",
			"start": 2230,
			"end": 2316
		},
		{
			"type": "Line",
			"value": " gap's own and is kept.",
			"start": 2318,
			"end": 2343
		},
		{
			"type": "Line",
			"value": " A frozen statement's terminator belongs to the printer too, so the blank below its",
			"start": 2407,
			"end": 2492
		},
		{
			"type": "Line",
			"value": " content reaches the gap by this same rule.",
			"start": 2494,
			"end": 2539
		},
		{
			"type": "Line",
			"value": " prettier-ignore",
			"start": 2541,
