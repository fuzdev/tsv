			"end": 295,
			"loc": {
				"start": {
					"line": 6,
					"column": 1
				},
				"end": {
					"line": 6,
					"column": 48
				}
			}
		},
		{
			"type": "Line",
			"value": " 101 - one char longer: the value drops below the `=`",
			"start": 435,
			"end": 490,
			"loc": {
				"start": {
					"line": 14,
					"column": 1
				},
				"end": {
					"line": 14,
					"column": 56
				}
			}
		},
		{
			"type": "Line",
			"value": " the value's own operators break under that same indent when the continuation overflows",
			"start": 634,
			"end": 723,
			"loc": {
				"start": {
					"line": 23,
					"column": 1
				},
				"end": {
					"line": 23,
					"column": 90
				}
			}
		},
		{
			"type": "Line",
			"value": " a call initializer expands its arguments rather than breaking after the `=`",
			"start": 882,
			"end": 960,
			"loc": {
				"start": {
					"line": 33,
					"column": 1
				},
				"end": {
					"line": 33,
					"column": 79
				}
			}
		},
		{
			"type": "Line",
			"value": " the call-object clause holds here too: a lone `.prop` off a call WITH ARGUMENTS",
			"start": 1110,
			"end": 1192,
			"loc": {
				"start": {
					"line": 43,
					"column": 1
				},
				"end": {
					"line": 43,
					"column": 83
				}
			}
		},
		{
			"type": "Line",
			"value": " carries no break point, so the width sheds into the arguments",
			"start": 1194,
			"end": 1258,
			"loc": {
				"start": {
					"line": 44,
					"column": 1
				},
				"end": {
					"line": 44,
					"column": 65
				}
			}
		},
		{
			"type": "Line",
			"value": " NOT the clause: the call has no arguments, so the lookup keeps its break point",
