			"end": 245,
			"loc": {
				"start": {
					"line": 4,
					"column": 1
				},
				"end": {
					"line": 4,
					"column": 51
				}
			}
		},
		{
			"type": "Line",
			"value": " 100 - the declarator fits on the clause line",
