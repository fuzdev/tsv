		{
			"type": "Line",
			"value": " A sole destructured parameter hugs the parens when its default is an empty object or",
			"start": 10,
			"end": 97
		},
		{
			"type": "Line",
			"value": " array, or an identifier: `({` opens on the signature line and the pattern breaks inside",
			"start": 99,
			"end": 189
		},
		{
			"type": "Line",
			"value": " A non-empty default: at 100 the whole signature still fits",
			"start": 474,
			"end": 535
		},
		{
			"type": "Line",
			"value": " at 101 the parameter is not hugged: the list expands and the pattern stays flat",
			"start": 653,
			"end": 735
		},
		{
			"type": "Line",
			"value": " An array pattern with a non-empty default expands the same way",
