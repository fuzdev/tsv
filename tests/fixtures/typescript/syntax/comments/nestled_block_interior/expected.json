	"comments": [
		{
			"type": "Line",
			"value": " What a NESTLED pair's text looks like coming out. The pair is one comment",
			"start": 10,
			"end": 86
		},
		{
			"type": "Line",
			"value": " (nestled_block_run), so its interior is reindented as one - the join line is the",
			"start": 88,
			"end": 171
		},
		{
			"type": "Line",
			"value": " first comment's last line, its `*/`, the second's `/*`, and that comment's first",
			"start": 173,
			"end": 256
		},
		{
			"type": "Line",
			"value": " line, all as a single continuation line taking a single leading space.",
			"start": 258,
			"end": 331
		},
		{
			"type": "Line",
			"value": " The join line carries content on both sides of the delimiters.",
			"start": 334,
			"end": 399
		},
		{
			"type": "Block",
			"value": "* a\n * z ",
			"start": 401,
			"end": 415
		},
		{
			"type": "Block",
			"value": "* b\n",
			"start": 415,
			"end": 425
		},
		{
			"type": "Line",
			"value": " ... and on neither.",
			"start": 442,
			"end": 464
		},
		{
			"type": "Block",
			"value": "*\n * a\n ",
			"start": 466,
			"end": 480
		},
		{
			"type": "Block",
			"value": "*\n* b\n",
			"start": 480,
			"end": 494
		},
		{
			"type": "Line",
			"value": " Nothing but the stars.",
			"start": 511,
			"end": 536
		},
		{
			"type": "Block",
			"value": "*\n ",
			"start": 538,
			"end": 546
		},
		{
