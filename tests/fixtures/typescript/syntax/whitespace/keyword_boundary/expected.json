	"comments": [
		{
			"type": "Line",
			"value": " A lookahead's identifier scan ends at every ECMAScript `WhiteSpace` and",
			"start": 20,
			"end": 94
		},
		{
			"type": "Line",
			"value": " `LineTerminator` character, not just `[ \\t\\n\\r]`, so a keyword followed by",
			"start": 96,
			"end": 173
		},
		{
			"type": "Line",
			"value": " one is still a keyword — the `unformatted_*` variants carry NBSP, ZWNBSP and",
			"start": 175,
			"end": 254
		},
		{
			"type": "Line",
			"value": " the `Zs` category in each keyword gap below, and both formatters normalize",
			"start": 256,
			"end": 333
		},
		{
			"type": "Line",
			"value": " them to the plain spaces here.",
			"start": 335,
			"end": 368
		},
		{
			"type": "Line",
			"value": "",
			"start": 370,
			"end": 372
		},
		{
			"type": "Line",
			"value": " The `Kµ` / `Aµ` names are the counter-case: U+00B5 shares NBSP's `0xC2` lead",
			"start": 374,
			"end": 453
		},
		{
			"type": "Line",
			"value": " byte and is an ordinary identifier character, so the scan crosses it.",
			"start": 455,
			"end": 527
		}
	],
