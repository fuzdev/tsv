	"comments": [
		{
			"type": "Line",
			"value": " A type keyword heading a `<` commits to type arguments only when what",
			"start": 20,
			"end": 92
		},
		{
			"type": "Line",
			"value": " follows it inside the angles could continue a type. `?`, `-`, `+`, and",
			"start": 94,
			"end": 167
		},
		{
			"type": "Line",
			"value": " `!=` cannot, so each line below is a comparison — even though the token",
			"start": 169,
			"end": 243
		},
		{
			"type": "Line",
			"value": " past the would-be closing `>` (a template tag, a parenthesized sequence)",
			"start": 245,
			"end": 320
		},
		{
			"type": "Line",
			"value": " does not itself start an expression.",
			"start": 322,
			"end": 361
		},
		{
			"type": "Line",
			"value": " The identifier arm answers the same question the same way.",
			"start": 583,
			"end": 644
		},
		{
			"type": "Line",
			"value": " Tokens that CAN continue a type keep committing: a qualified tail and a",
			"start": 681,
			"end": 755
		},
		{
			"type": "Line",
			"value": " union read as instantiations, exactly as they do for an identifier head.",
			"start": 757,
			"end": 832
		},
		{
			"type": "Line",
			"value": " The type-operator keywords are keyword-then-operand and open type",
			"start": 904,
			"end": 972
		},
		{
			"type": "Line",
			"value": " arguments when an operand follows.",
			"start": 974,
			"end": 1011
		},
		{
			"type": "Line",
			"value": " Literal heads answer the same follow-token question: a numeric, string,",
			"start": 1069,
			"end": 1143
		},
		{
			"type": "Line",
			"value": " template, tuple, or parenthesized operand followed by arithmetic or a",
			"start": 1145,
			"end": 1217
		},
		{
			"type": "Line",
			"value": " ternary is a comparison…",
			"start": 1219,
			"end": 1246
		},
		{
			"type": "Line",
			"value": " …while a type-continuing follow still commits.",
			"start": 1457,
			"end": 1506
		},
		{
			"type": "Line",
			"value": " An operator keyword with no operand after it is an ordinary value name —",
			"start": 1589,
			"end": 1664
		},
		{
			"type": "Line",
			"value": " a bare name or an arithmetic operand stays a comparison…",
			"start": 1666,
			"end": 1725
		},
		{
			"type": "Line",
			"value": " …but keyof and unique take ANY type operand, so a literal after them",
			"start": 1844,
			"end": 1915
		},
		{
			"type": "Line",
			"value": " still opens type arguments.",
			"start": 1917,
			"end": 1947
		},
		{
			"type": "Line",
			"value": " `this.` is member access, never a type head.",
			"start": 2010,
			"end": 2057
		}
	],
