			"value": " c3",
			"start": 217,
			"end": 222
		},
		{
			"type": "Line",
			"value": " So does a sign operator, whose parens the operand requires",
			"start": 238,
			"end": 299
		},
		{
			"type": "Line",
			"value": " c4",
			"start": 314,
			"end": 319
		},
		{
			"type": "Line",
			"value": " Only the glued comment claims the line - the rest of the run keeps its own",
			"start": 334,
			"end": 411
		},
		{
			"type": "Line",
			"value": " c5",
			"start": 426,
			"end": 431
		},
		{
			"type": "Line",
			"value": " c6",
			"start": 434,
			"end": 439
		},
		{
			"type": "Line",
			"value": " A block glued to the `(` claims nothing, so the whole run stays below it",
			"start": 455,
			"end": 530
		},
		{
			"type": "Block",
			"value": " c7 ",
			"start": 547,
			"end": 555
		},
		{
			"type": "Line",
			"value": " c8",
			"start": 556,
			"end": 561
		},
		{
			"type": "Line",
			"value": " An author blank below the glued comment survives it",
			"start": 577,
			"end": 631
		},
		{
			"type": "Line",
			"value": " c9",
			"start": 646,
			"end": 651
		},
		{
			"type": "Line",
			"value": " Control - written on its own line the comment keeps its own line, and",
			"start": 668,
			"end": 740
		},
		{
			"type": "Line",
			"value": " prettier agrees",
			"start": 742,
			"end": 760
		},
		{
			"type": "Line",
			"value": " c10",
			"start": 777,
			"end": 783
		},
		{
			"type": "Line",
			"value": " Control - a run of blocks the author glued owns no line, so the parens",
			"start": 799,
			"end": 872
		},
		{
			"type": "Line",
			"value": " still decide their own width",
			"start": 874,
			"end": 905
		},
		{
			"type": "Block",
			"value": " c11 ",
			"start": 919,
			"end": 928
		},
		{
			"type": "Block",
			"value": " c12 ",
			"start": 929,
			"end": 938
		},
		{
			"type": "Line",
			"value": " The comment-holder's gap opens at the OPERATOR, so the author may put the `(` on a",
			"start": 945,
			"end": 1030
		},
		{
			"type": "Line",
			"value": " line of its own; the break it takes there is structure, and no blank is invented",
			"start": 1032,
			"end": 1115
		},
		{
			"type": "Line",
			"value": " c13",
			"start": 1131,
			"end": 1137
		},
		{
			"type": "Line",
			"value": " The same, from an authoring that also left a blank BELOW that `(` — that one sits",
			"start": 1153,
			"end": 1237
		},
		{
			"type": "Line",
			"value": " against the delimiter and stays erased",
			"start": 1239,
			"end": 1280
		},
		{
			"type": "Line",
			"value": " c14",
			"start": 1296,
			"end": 1302
		},
		{
			"type": "Line",
			"value": " A blank the author wrote between the comment and the `(` is authorship and rides",
			"start": 1318,
			"end": 1401
		},
		{
			"type": "Line",
			"value": " c15",
			"start": 1417,
			"end": 1423
		},
		{
			"type": "Line",
			"value": " The rule keeps an ignore DIRECTIVE on that line too, and that is what leaves it inert:",
			"start": 1440,
			"end": 1529
		},
		{
			"type": "Line",
			"value": " the placement floor reads only a directive alone on its line, so the operand normalizes.",
			"start": 1531,
			"end": 1622
		},
		{
			"type": "Line",
			"value": " Forcing it onto its own line to \"honor\" it would ARM a freeze the author never asked",
			"start": 1624,
			"end": 1711
		},
		{
			"type": "Line",
			"value": " for — see the sibling head fixture, where the own-line authoring does freeze.",
			"start": 1713,
			"end": 1793
		},
		{
			"type": "Line",
			"value": " prettier-ignore",
			"start": 1814,
			"end": 1832
		}
	],
