	"comments": [
		{
			"type": "Line",
			"value": " A line comment before the cast keyword keeps the grouping parens that hold it.",
			"start": 20,
			"end": 101
		},
		{
			"type": "Line",
			"value": " c1",
			"start": 119,
			"end": 124
		},
		{
			"type": "Line",
			"value": " Same for `satisfies`.",
			"start": 136,
			"end": 160
		},
		{
			"type": "Line",
			"value": " c2",
			"start": 178,
			"end": 183
		},
		{
			"type": "Line",
			"value": " `as const` is no exception.",
			"start": 202,
			"end": 232
		},
		{
			"type": "Line",
			"value": " c3",
			"start": 250,
			"end": 255
		},
		{
			"type": "Line",
			"value": " A chained cast keeps the comment on the inner cast's operand.",
			"start": 271,
			"end": 335
		},
		{
			"type": "Line",
			"value": " c4",
			"start": 353,
			"end": 358
		},
		{
			"type": "Line",
			"value": " `satisfies` chained into `as`.",
			"start": 381,
			"end": 414
		},
		{
			"type": "Line",
			"value": " c5",
			"start": 432,
			"end": 437
		},
		{
			"type": "Line",
			"value": " An object operand.",
			"start": 461,
			"end": 482
		},
		{
			"type": "Line",
			"value": " c6",
			"start": 510,
			"end": 515
		},
		{
			"type": "Line",
			"value": " Two stacked line comments each keep their own line.",
			"start": 531,
			"end": 585
		},
		{
			"type": "Line",
			"value": " c7",
			"start": 603,
			"end": 608
		},
		{
			"type": "Line",
			"value": " c8",
			"start": 611,
			"end": 616
		},
		{
			"type": "Line",
			"value": " An operand that needs the parens anyway takes no second pair.",
			"start": 628,
			"end": 692
		},
		{
			"type": "Line",
			"value": " c9",
			"start": 714,
			"end": 719
		},
		{
			"type": "Line",
			"value": " A bare expression statement, not a declarator.",
			"start": 731,
			"end": 780
		},
		{
			"type": "Line",
			"value": " c10",
			"start": 788,
			"end": 794
		},
		{
			"type": "Line",
			"value": " A multiline block comment breaks the line too, so it keeps the parens — and a",
			"start": 810,
			"end": 890
		},
		{
			"type": "Line",
			"value": " shell that breaks expands rather than gluing its operand to the `(`.",
			"start": 892,
			"end": 963
		},
		{
			"type": "Block",
			"value": " m1\n\tm2 ",
			"start": 981,
			"end": 993
		},
		{
			"type": "Line",
			"value": " An object operand at statement position: the shell's `(` already keeps the",
			"start": 1005,
			"end": 1082
		},
		{
			"type": "Line",
			"value": " statement from starting with `{`, so no second pair is added.",
			"start": 1084,
			"end": 1148
		},
		{
			"type": "Line",
			"value": " c19",
			"start": 1166,
			"end": 1172
		},
		{
			"type": "Line",
			"value": " The shell's other gap: a comment on the `(` line stays on it, with the operand",
			"start": 1188,
			"end": 1269
		},
		{
			"type": "Line",
			"value": " indented below.",
			"start": 1271,
			"end": 1289
		},
		{
			"type": "Line",
			"value": " c12",
			"start": 1303,
			"end": 1309
		},
		{
			"type": "Line",
			"value": " c13",
			"start": 1314,
			"end": 1320
		},
		{
			"type": "Line",
			"value": " An own-line block above the operand keeps its own line inside the shell.",
			"start": 1332,
			"end": 1407
		},
		{
			"type": "Block",
			"value": " c14 ",
			"start": 1423,
			"end": 1432
		},
		{
			"type": "Line",
			"value": " c15",
			"start": 1437,
			"end": 1443
		},
		{
			"type": "Line",
			"value": " A block glued to the operand leads it inline instead.",
			"start": 1455,
			"end": 1511
		},
		{
			"type": "Block",
			"value": " c16 ",
			"start": 1527,
			"end": 1536
		},
		{
			"type": "Line",
			"value": " c17",
			"start": 1539,
			"end": 1545
		},
		{
			"type": "Line",
			"value": " A leading comment alone still keeps the shell that holds it.",
			"start": 1557,
			"end": 1620
		},
		{
			"type": "Line",
			"value": " c18",
			"start": 1634,
			"end": 1640
		},
		{
			"type": "Line",
			"value": " A block comment does not end its line, so it stays inline without parens.",
			"start": 1656,
			"end": 1732
		},
		{
			"type": "Block",
			"value": " c11 ",
			"start": 1746,
			"end": 1755
		},
		{
			"type": "Line",
			"value": " A comment AFTER the `)` is in the gap OUTSIDE the pair: the shell's own trailing",
			"start": 1764,
			"end": 1847
		},
		{
			"type": "Line",
			"value": " run stays inside it and this one trails the `)`, before the keyword.",
			"start": 1849,
			"end": 1920
		},
		{
			"type": "Line",
			"value": " c20",
			"start": 1938,
			"end": 1944
		},
		{
			"type": "Block",
			"value": " c21 ",
			"start": 1948,
			"end": 1957
		},
		{
			"type": "Line",
			"value": " Both shell gaps plus the outside one, each emitted where it was written.",
			"start": 1966,
			"end": 2041
		},
		{
			"type": "Line",
			"value": " c22",
			"start": 2055,
			"end": 2061
		},
		{
			"type": "Line",
			"value": " c23",
			"start": 2066,
			"end": 2072
		},
		{
			"type": "Block",
			"value": " c24 ",
			"start": 2076,
			"end": 2085
		},
		{
			"type": "Line",
			"value": " A comment outside the pair with nothing inside it needs no shell at all.",
			"start": 2094,
			"end": 2169
		},
		{
			"type": "Block",
			"value": " c25 ",
			"start": 2183,
			"end": 2192
		},
		{
			"type": "Line",
			"value": " A run outside the pair stays a run, in the order it was written.",
			"start": 2201,
			"end": 2268
		},
		{
			"type": "Line",
			"value": " c26",
			"start": 2286,
			"end": 2292
		},
		{
			"type": "Block",
			"value": " c27 ",
			"start": 2296,
			"end": 2305
		},
		{
			"type": "Block",
			"value": " c28 ",
			"start": 2306,
			"end": 2315
		},
		{
			"type": "Line",
			"value": " Nested shells collapse into the one emitted pair, so the split is the OUTERMOST",
			"start": 2324,
			"end": 2406
		},
		{
			"type": "Line",
			"value": " `)`: `((x // c29⏎) /* c30 */) /* c31 */ as A` settles here, with the comment",
			"start": 2408,
			"end": 2487
		},
		{
			"type": "Line",
			"value": " between the two closers inside the pair and the one past both outside it.",
			"start": 2489,
			"end": 2565
		},
		{
			"type": "Line",
			"value": " c29",
			"start": 2583,
			"end": 2589
		},
		{
			"type": "Block",
			"value": " c30 ",
			"start": 2592,
			"end": 2601
		},
		{
			"type": "Block",
			"value": " c31 ",
			"start": 2605,
			"end": 2614
		},
		{
			"type": "Line",
			"value": " an author blank BELOW the pulled comment survives — the blank is authorship, not",
			"start": 2623,
			"end": 2706
		},
		{
			"type": "Line",
			"value": " the container's leading gap (the blank ABOVE one stays erased, against the delimiter)",
			"start": 2708,
			"end": 2796
		},
		{
			"type": "Line",
			"value": " c19",
			"start": 2810,
			"end": 2816
		}
	],
