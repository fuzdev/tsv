	"comments": [
		{
			"type": "Line",
			"value": " The same clause's object operand, read literally: the lookup's object must be a bare",
			"start": 20,
			"end": 107,
			"loc": {
				"start": {
					"line": 2,
					"column": 1
				},
				"end": {
					"line": 2,
					"column": 88
				}
			}
		},
		{
			"type": "Line",
			"value": " identifier, so the lookup has to sit immediately after the base. A `!` or a `?.` on the",
			"start": 109,
			"end": 199,
			"loc": {
				"start": {
					"line": 3,
					"column": 1
				},
				"end": {
					"line": 3,
					"column": 91
				}
			}
		},
		{
			"type": "Line",
			"value": " OTHER side is a chain-element wrapper rather than a member, and neither disqualifies it.",
