			"end": 292,
			"loc": {
				"start": {
					"line": 4,
					"column": 1
				},
				"end": {
					"line": 4,
					"column": 92
				}
			}
		},
		{
			"type": "Line",
			"value": " the object is a computed lookup, not an identifier",
			"start": 323,
			"end": 376,
			"loc": {
				"start": {
					"line": 8,
					"column": 3
				},
				"end": {
