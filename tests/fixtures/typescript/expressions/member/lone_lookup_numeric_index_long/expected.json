	"comments": [
		{
			"type": "Line",
			"value": " Prettier's `shouldInline` lone-`.prop` clause needs the lookup's PARENT not to be a",
			"start": 20,
			"end": 106
		},
		{
			"type": "Line",
			"value": " member — and a computed lookup is one, so `a.p[0]` gives the `.p` a break point",
			"start": 108,
			"end": 190
		},
		{
			"type": "Line",
			"value": " exactly as `a.p.q` does. The index then rides the line the lookup lands on, sitting",
			"start": 192,
			"end": 278
		},
		{
			"type": "Line",
			"value": " OUTSIDE the lookup's own group.",
			"start": 280,
			"end": 314
		},
		{
			"type": "Line",
			"value": " a numeric index keeps its brackets flat, so the lookup is the only break point -",
			"start": 358,
			"end": 441
		},
		{
			"type": "Line",
			"value": " at exactly 100 the whole thing still fits",
			"start": 445,
			"end": 489
		},
		{
			"type": "Line",
			"value": " one char more, and the lookup takes its own line, carrying the index with it",
			"start": 592,
			"end": 671
		},
		{
			"type": "Line",
			"value": " the `!` and `?.` spellings answer the same way",
			"start": 780,
			"end": 829
		},
		{
			"type": "Line",
			"value": " a NON-numeric index has breakable brackets, and THEY shed the width instead: the",
			"start": 1042,
			"end": 1125
		},
		{
			"type": "Line",
			"value": " lookup's group is measured only as far as the bracket softline, so it stays flat",
			"start": 1129,
			"end": 1212
		}
	],
