	"comments": [
		{
			"type": "Line",
			"value": " A head with a non-Identifier parameter breaks the whole chain however short it is —",
			"start": 20,
			"end": 106
		},
		{
			"type": "Line",
			"value": " each head takes its own line under the `=` (prettier's shouldBreakChain)",
			"start": 108,
			"end": 183
		},
		{
			"type": "Line",
			"value": " Type parameters on a head break it too",
			"start": 347,
			"end": 388
		},
		{
			"type": "Line",
			"value": " A return type breaks only when that head also HAS parameters",
			"start": 440,
			"end": 503
		},
		{
			"type": "Line",
			"value": " The trigger is asked of EVERY head, not just the first",
			"start": 580,
			"end": 637
		},
		{
			"type": "Line",
			"value": " A plain identifier parameter is simple — an annotation on it does not change that",
			"start": 686,
			"end": 770
		},
		{
			"type": "Line",
			"value": " In a call argument the broken chain progressive-indents instead of sharing one indent",
			"start": 838,
			"end": 926
		},
		{
			"type": "Line",
			"value": " A binaryish operand takes the same progressive shape",
			"start": 1026,
			"end": 1081
		},
		{
			"type": "Line",
			"value": " A hugging terminal body still hugs the last head — the break denies the ternary its",
			"start": 1136,
			"end": 1222
		},
		{
			"type": "Line",
			"value": " same-line parens (below) but never these",
			"start": 1224,
			"end": 1267
		},
		{
			"type": "Line",
			"value": " A sequence terminal hugs too — its parens are the point, so shouldAlwaysAddParens is",
			"start": 1311,
			"end": 1398
		},
		{
			"type": "Line",
			"value": " not gated on the break the way the ternary is",
			"start": 1400,
			"end": 1448
		},
		{
			"type": "Line",
			"value": " A ternary terminal is the one hugging body the break DOES deny: the parens exist only",
			"start": 1497,
			"end": 1585
		},
		{
			"type": "Line",
			"value": " to hold it on one line, which a stacked chain has already given up",
			"start": 1587,
			"end": 1656
		}
	],
