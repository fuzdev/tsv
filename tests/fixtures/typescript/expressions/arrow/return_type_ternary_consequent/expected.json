	"comments": [
		{
			"type": "Line",
			"value": " `(c) : d => e` in a consequent is `c` and the ternary's `:` — the would-be arrow",
			"start": 20,
			"end": 103,
			"loc": {
				"start": {
					"line": 2,
					"column": 1
				},
				"end": {
					"line": 2,
					"column": 84
				}
			}
		},
		{
			"type": "Line",
			"value": " `(c): d => e` is not followed by a second `:`, so the `:` cannot annotate it",
			"start": 105,
			"end": 184,
			"loc": {
				"start": {
					"line": 3,
					"column": 1
				},
				"end": {
					"line": 3,
					"column": 80
				}
			}
		},
		{
			"type": "Line",
			"value": " The same one level down: `({ y }) : z => …` inside the consequent arrow's body",
			"start": 217,
			"end": 298,
			"loc": {
				"start": {
					"line": 6,
					"column": 1
				},
				"end": {
					"line": 6,
					"column": 82
				}
			}
		},
		{
			"type": "Line",
			"value": " A consequent arrow followed by the ternary's `:` keeps its return type, while its",
			"start": 350,
			"end": 434,
			"loc": {
				"start": {
					"line": 9,
					"column": 1
				},
				"end": {
					"line": 9,
					"column": 85
				}
			}
		},
		{
			"type": "Line",
			"value": " own body `(d) : e => f` is the plain `d`: after `f` no second `:` follows",
			"start": 436,
			"end": 512,
			"loc": {
				"start": {
					"line": 10,
					"column": 1
				},
				"end": {
					"line": 10,
					"column": 77
				}
			}
		},
		{
			"type": "Line",
			"value": " A nested ternary's alternate `(d) : e => f`: the `:` is the outer ternary's",
			"start": 555,
			"end": 633,
			"loc": {
				"start": {
					"line": 13,
					"column": 1
				},
				"end": {
					"line": 13,
					"column": 79
				}
			}
		},
		{
			"type": "Line",
			"value": " A consequent arrow's body `(c): d => e`: the `:` is the ternary's",
			"start": 676,
			"end": 744,
			"loc": {
				"start": {
					"line": 16,
					"column": 1
				},
				"end": {
					"line": 16,
					"column": 69
				}
			}
		},
		{
			"type": "Line",
			"value": " A head that is no parameter list: `(b + c) : d => e` is the consequent `b + c`",
			"start": 784,
			"end": 865,
			"loc": {
				"start": {
					"line": 19,
					"column": 1
				},
				"end": {
					"line": 19,
					"column": 82
				}
			}
		},
		{
			"type": "Line",
			"value": " Outside a ternary consequent the `:` is a return type",
