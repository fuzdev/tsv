	"comments": [
		{
			"type": "Line",
			"value": " A break-forcing head stacks EVERY head of the chain, the plain ones after it too —",
			"start": 10,
			"end": 95
		},
		{
			"type": "Line",
			"value": " prettier's shouldBreakChain is one verdict for the whole chain, not per head",
			"start": 97,
			"end": 176
		},
		{
			"type": "Line",
			"value": " The trigger anywhere in the chain stacks the heads on both sides of it",
			"start": 290,
			"end": 363
		},
		{
			"type": "Line",
			"value": " A block terminal hugs the LAST head only",
			"start": 426,
			"end": 469
		},
		{
			"type": "Line",
			"value": " Every assignment-like site stacks the same way",
			"start": 609,
			"end": 658
		},
		{
			"type": "Line",
			"value": " A hugging terminal still hugs the last head",
			"start": 835,
			"end": 881
		},
		{
			"type": "Line",
			"value": " A chain in a stacked head's default parameter is its own chain, in no chain position:",
			"start": 938,
			"end": 1026
		},
		{
			"type": "Line",
			"value": " it takes the default shape, not the enclosing chain's stacking",
			"start": 1028,
			"end": 1093
		}
	],
