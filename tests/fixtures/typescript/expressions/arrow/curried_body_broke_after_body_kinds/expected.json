			"end": 450
		},
		{
			"type": "Block",
			"value": " c ",
			"start": 481,
			"end": 488
		},
		{
			"type": "Line",
			"value": " an object literal the author blanked, which breaks for the same reason",
			"start": 502,
			"end": 575
		},
		{
			"type": "Block",
			"value": " c ",
			"start": 606,
			"end": 613
		},
		{
			"type": "Line",
			"value": " a call whose function argument breaks it",
