	"comments": [
		{
			"type": "Line",
			"value": " A curried chain as a callee opens its parens onto their own lines when its own body",
			"start": 10,
			"end": 96
		},
		{
			"type": "Line",
			"value": " hangs, however a chain nested in it resolved",
			"start": 98,
			"end": 145
		},
		{
			"type": "Line",
			"value": " A short chain in the body stays inline, and the `)` still closes on its own line",
			"start": 148,
			"end": 231
		},
		{
			"type": "Line",
			"value": " A chain in a parameter default forces the heads to break, and a hugging body hugs the",
			"start": 568,
			"end": 656
		},
		{
			"type": "Line",
			"value": " last head inside the open parens",
			"start": 658,
			"end": 693
		},
		{
			"type": "Line",
			"value": " The same chain with a plain body: the body hangs one level under the last head, and",
			"start": 752,
			"end": 838
		},
		{
			"type": "Line",
			"value": " the `)` closes on its own line",
			"start": 840,
			"end": 873
		},
		{
			"type": "Line",
			"value": " Two chains nested in the body, in either order: one breaks, one stays inline, and",
			"start": 926,
			"end": 1010
		},
		{
			"type": "Line",
			"value": " neither decides the enclosing chain's `)`",
			"start": 1012,
			"end": 1056
		}
	],
