	"comments": [
		{
			"type": "Line",
			"value": " A concise body cannot START with `@`, so a DECORATED class expression at the body's",
			"start": 20,
			"end": 106,
			"loc": {
				"start": {
					"line": 2,
					"column": 1
				},
				"end": {
					"line": 2,
					"column": 87
				}
			}
		},
		{
			"type": "Line",
			"value": " leftmost position takes a paren pair of its own — around the class alone, exactly as",
			"start": 108,
			"end": 195,
			"loc": {
				"start": {
					"line": 3,
					"column": 1
				},
				"end": {
					"line": 3,
					"column": 88
				}
			}
		},
		{
			"type": "Line",
			"value": " a leftmost object literal does. The pair breaks open, since the decorator owns a line.",
			"start": 197,
			"end": 286,
			"loc": {
				"start": {
					"line": 4,
					"column": 1
				},
				"end": {
					"line": 4,
					"column": 90
				}
			}
		},
		{
			"type": "Line",
			"value": " A frozen body whose ROOT is the class takes the same pair — it is the position's, so",
			"start": 508,
			"end": 595,
			"loc": {
				"start": {
					"line": 31,
					"column": 1
				},
				"end": {
					"line": 31,
					"column": 88
				}
			}
		},
		{
			"type": "Line",
			"value": " it rides outside the slice. A frozen COMPOSITE body is not this fixture's claim: the",
			"start": 597,
			"end": 684,
			"loc": {
				"start": {
					"line": 32,
					"column": 1
				},
				"end": {
					"line": 32,
					"column": 88
				}
			}
		},
		{
			"type": "Line",
			"value": " slice is emitted from the position, which never reaches the leftmost node.",
			"start": 686,
			"end": 763,
			"loc": {
				"start": {
					"line": 33,
					"column": 1
				},
				"end": {
					"line": 33,
					"column": 78
				}
			}
		},
		{
			"type": "Line",
			"value": " prettier-ignore",
			"start": 785,
			"end": 803,
			"loc": {
				"start": {
					"line": 35,
					"column": 2
				},
				"end": {
