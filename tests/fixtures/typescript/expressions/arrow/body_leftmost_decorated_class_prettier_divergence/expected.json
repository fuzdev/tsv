				}
			}
		},
		{
			"type": "Line",
			"value": " An UNDECORATED class opens a concise body fine and stays bare, and a leftmost object",
			"start": 827,
			"end": 914,
			"loc": {
				"start": {
					"line": 38,
					"column": 1
				},
				"end": {
					"line": 38,
