	"comments": [
		{
			"type": "Line",
			"value": " The callee rule holds whatever the callee is built from — a `!` link, a parenthesized",
			"start": 20,
			"end": 108
		},
		{
			"type": "Line",
			"value": " base, a call link — each keeps its own break points and becomes the only ones left. It",
			"start": 110,
			"end": 199
		},
		{
			"type": "Line",
			"value": " stops where the chain is no longer the callee itself.",
			"start": 201,
			"end": 257
		},
		{
			"type": "Line",
			"value": " a non-null in the callee — the `!` glues to its lookup and adds no break point",
			"start": 260,
			"end": 341
		},
		{
			"type": "Line",
			"value": " type arguments ride the callee, past the last lookup",
			"start": 445,
			"end": 500
		},
		{
			"type": "Line",
			"value": " a parenthesized base in the callee — the base's own parens are the only break point",
			"start": 604,
			"end": 690
		},
		{
			"type": "Line",
			"value": " a call in the callee — the clause reaches the lookups above it, the call keeps its args",
			"start": 799,
			"end": 889
		},
		{
			"type": "Line",
			"value": " a computed index holding its own assignment — the callee is marked before any node doc",
			"start": 998,
			"end": 1087
		},
		{
			"type": "Line",
			"value": " is built, so the nested target's mark cannot clear it and the lookups after `]` stay glued",
			"start": 1089,
			"end": 1182
		},
		{
			"type": "Line",
			"value": " NOT the callee: an optional chain is a `ChainExpression`, which the walk stops at",
			"start": 1296,
			"end": 1380
		},
		{
			"type": "Line",
			"value": " NOT the callee: a chain inside a computed index keeps its break points",
			"start": 1490,
			"end": 1563
		},
		{
			"type": "Line",
			"value": " NOT the callee: members trailing the `new` expression keep their break points",
			"start": 1690,
			"end": 1770
		},
		{
			"type": "Line",
			"value": " NOT the callee: the callee IS a cast, so the mark stops at it — the cast hangs its",
			"start": 1877,
			"end": 1962
		},
		{
			"type": "Line",
			"value": " own pair and the operand chain inside keeps every lookup's break point",
			"start": 1964,
			"end": 2037
		}
	],
