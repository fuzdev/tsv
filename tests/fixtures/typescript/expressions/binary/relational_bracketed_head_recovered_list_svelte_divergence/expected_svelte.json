			"type": "Line",
			"value": " one it lands on, so the compiler rejects the line; tsv follows it and rejects too,",
			"start": 365,
			"end": 450
		},
		{
			"type": "Line",
			"value": " while acorn-typescript backs off the failed list and reads the comparison chain that",
			"start": 452,
			"end": 539
		},
		{
			"type": "Line",
			"value": " `expected_svelte.json` records.",
			"start": 541,
