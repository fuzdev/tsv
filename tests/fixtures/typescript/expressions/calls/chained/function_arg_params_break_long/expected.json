	"comments": [
		{
			"type": "Line",
			"value": " A sole `function` argument whose parameters are not all plain identifiers keeps a",
			"start": 20,
			"end": 104
		},
		{
			"type": "Line",
			"value": " breakable parameter list inside the hug (prettier's `printFunction` flattens the list",
			"start": 106,
			"end": 194
		},
		{
			"type": "Line",
			"value": " only past that gate), and its body's forced break makes the hug the FIRST state the",
			"start": 196,
			"end": 282
		},
		{
			"type": "Line",
			"value": " call offers - so a chain measuring the call sees the hug and stops at the parameter",
			"start": 284,
			"end": 370
		},
		{
			"type": "Line",
			"value": " list's own break, rather than reading the whole signature flat.",
			"start": 372,
			"end": 438
		},
		{
			"type": "Line",
			"value": " 100 - the merged short chain, everything on one line",
			"start": 441,
			"end": 496
		},
		{
			"type": "Line",
			"value": " 101 - the hug holds, the parameters break",
			"start": 614,
			"end": 658
		},
		{
			"type": "Line",
			"value": " an EMPTY body carries no forced break, so the call keeps its inline state; the",
			"start": 905,
			"end": 986
		},
		{
			"type": "Line",
			"value": " short chain is still a plain group, whose renderer walks that ladder to the hug",
			"start": 988,
			"end": 1070
		},
		{
			"type": "Line",
			"value": " the long chain under an assignment stays flat for the same reason",
			"start": 1187,
			"end": 1255
		},
		{
			"type": "Line",
			"value": " all-plain parameters render flat, so the hug cannot fit and the argument breaks out",
			"start": 1381,
			"end": 1467
		},
		{
			"type": "Line",
			"value": " a second argument flattens the list too",
			"start": 1593,
			"end": 1635
		}
	],
