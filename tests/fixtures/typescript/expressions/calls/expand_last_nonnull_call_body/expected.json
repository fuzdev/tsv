	"comments": [
		{
			"type": "Line",
			"value": " An arrow body that is a call through a trailing `!`: prettier's `couldExpandArg`",
			"start": 20,
			"end": 103,
			"loc": {
				"start": {
					"line": 2,
					"column": 1
				},
				"end": {
					"line": 2,
					"column": 84
				}
			}
		},
		{
			"type": "Line",
			"value": " strips the non-null wrapper (`stripChainElementWrappers`), so the break-body",
			"start": 105,
			"end": 184,
			"loc": {
				"start": {
					"line": 3,
					"column": 1
				},
				"end": {
					"line": 3,
					"column": 80
				}
			}
		},
		{
			"type": "Line",
			"value": " ladder applies — at all three spellings, not just the plain call and `new`.",
			"start": 186,
			"end": 264,
			"loc": {
				"start": {
					"line": 4,
					"column": 1
				},
				"end": {
					"line": 4,
					"column": 79
				}
			}
		},
		{
			"type": "Line",
			"value": " Repeated `!` strips the same way.",
			"start": 468,
			"end": 504,
			"loc": {
				"start": {
					"line": 29,
					"column": 1
				},
				"end": {
					"line": 29,
					"column": 37
				}
			}
		},
		{
			"type": "Line",
			"value": " Contrast: a MEMBER through `!` is not a call, so no spelling expands.",
			"start": 558,
			"end": 630,
			"loc": {
				"start": {
					"line": 36,
					"column": 1
				},
				"end": {
					"line": 36,
					"column": 73
				}
			}
		},
		{
			"type": "Line",
			"value": " Contrast: a ternary through `!` — the ternary arm reads the body's own type and",
			"start": 696,
			"end": 778,
			"loc": {
				"start": {
					"line": 45,
					"column": 1
				},
				"end": {
					"line": 45,
					"column": 83
				}
			}
		},
		{
			"type": "Line",
			"value": " never strips, so the non-null wrapper takes this out of both arms.",
			"start": 780,
			"end": 849,
			"loc": {
				"start": {
					"line": 46,
					"column": 1
				},
				"end": {
