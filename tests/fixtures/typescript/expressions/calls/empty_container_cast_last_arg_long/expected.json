	"comments": [
		{
			"type": "Line",
			"value": " Prettier's `couldExpandArg` hugs an object or array last argument only when it is",
			"start": 20,
			"end": 104
		},
		{
			"type": "Line",
			"value": " non-empty or carries a comment, and reads that through a cast. An EMPTY literal under",
			"start": 106,
			"end": 194
		},
		{
			"type": "Line",
			"value": " a cast has nothing to expand: the hug would break the cast's `<...>` instead, so the",
			"start": 196,
			"end": 283
		},
		{
			"type": "Line",
			"value": " arguments break out.",
			"start": 285,
			"end": 308
		},
		{
			"type": "Line",
			"value": " 100 - fits",
			"start": 311,
			"end": 324
		},
		{
			"type": "Line",
			"value": " 101 - every argument on its own line, the cast whole",
			"start": 427,
			"end": 482
		},
		{
			"type": "Line",
			"value": " the chain spelling of the same call",
			"start": 809,
			"end": 847
		},
		{
			"type": "Line",
			"value": " a comment between the cast and the literal attaches to the LITERAL, so the same",
			"start": 958,
			"end": 1040
		},
		{
			"type": "Line",
			"value": " clause makes an empty one expandable and the cast's `<...>` is what breaks",
			"start": 1042,
			"end": 1119
		},
		{
			"type": "Line",
			"value": " 100 - fits",
			"start": 1122,
			"end": 1135
		},
		{
			"type": "Block",
			"value": " c ",
			"start": 1223,
			"end": 1230
		},
		{
			"type": "Line",
			"value": " 101 - the cast breaks, the literal keeps the `>` line",
			"start": 1238,
			"end": 1294
		},
		{
			"type": "Block",
			"value": " c ",
			"start": 1388,
			"end": 1395
		},
		{
			"type": "Block",
			"value": " c ",
			"start": 1494,
			"end": 1501
		},
		{
			"type": "Line",
			"value": " a NON-EMPTY literal under the cast still hugs, and so does an empty one holding a comment",
			"start": 1509,
			"end": 1601
		},
		{
			"type": "Block",
			"value": " c ",
			"start": 1801,
			"end": 1808
		}
