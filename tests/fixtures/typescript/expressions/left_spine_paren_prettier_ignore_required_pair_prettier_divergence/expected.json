		},
		{
			"type": "Line",
			"value": " prettier-ignore",
			"start": 644,
			"end": 662
		},
		{
			"type": "Line",
			"value": " a `**` left operand, which is right-associative too",
			"start": 692,
			"end": 746
		},
		{
			"type": "Line",
			"value": " prettier-ignore",
			"start": 760,
			"end": 778
		},
		{
			"type": "Line",
			"value": " one pair, not two, where the position's own leftmost target would also ask for one",
			"start": 800,
			"end": 885
		},
		{
			"type": "Line",
			"value": " prettier-ignore",
			"start": 887,
