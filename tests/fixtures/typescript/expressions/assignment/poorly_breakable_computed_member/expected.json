		{
			"type": "Line",
			"value": " Prettier's `isPoorlyBreakableMemberOrCallChain` descends a member's OBJECT only and never",
			"start": 10,
			"end": 102
		},
		{
			"type": "Line",
			"value": " reads a computed member's index, so an index that forces a break leaves the chain poorly",
			"start": 104,
			"end": 195
		},
		{
			"type": "Line",
			"value": " breakable: the value breaks after the operator and the index expands inside it",
			"start": 197,
			"end": 278
		},
		{
			"type": "Line",
			"value": " a multiline template call in the computed member's index, at every assignment operator",
			"start": 281,
			"end": 370
		},
		{
			"type": "Line",
			"value": " a class property, and an object property: a short key keeps the value on its line, a longer",
			"start": 494,
			"end": 588
		},
		{
			"type": "Line",
			"value": " key breaks after the colon",
			"start": 590,
			"end": 619
		},
		{
			"type": "Line",
			"value": " a declarator takes the same layout",
			"start": 742,
			"end": 779
		},
		{
			"type": "Line",
			"value": " a bare or tagged multiline template as the index, at any depth",
			"start": 817,
			"end": 882
		},
		{
			"type": "Line",
			"value": " the operand of a wrapper, or a chain rooted at `this` or reached through `?.`",
			"start": 967,
			"end": 1047
		},
		{
			"type": "Line",
			"value": " the chain continuing past the bracket",
			"start": 1173,
			"end": 1213
		},
		{
			"type": "Line",
			"value": " other indexes that force a break: a block body, an authored-expanded object",
			"start": 1307,
			"end": 1385
		},
		{
			"type": "Line",
			"value": " control: the template as a call argument instead keeps the chain on the operator line",
			"start": 1462,
			"end": 1550
		}
	],
