	"comments": [
		{
			"type": "Line",
			"value": " Prettier's `isPoorlyBreakableMemberOrCallChain` bottoms out at an `Identifier` or a",
			"start": 20,
			"end": 106,
			"loc": {
				"start": {
					"line": 2,
					"column": 1
				},
				"end": {
					"line": 2,
					"column": 87
				}
			}
		},
		{
			"type": "Line",
			"value": " `ThisExpression` — and at nothing else, `super` included. A chain that qualifies breaks",
			"start": 108,
			"end": 198,
			"loc": {
				"start": {
					"line": 3,
					"column": 1
				},
				"end": {
					"line": 3,
					"column": 91
				}
			}
		},
		{
			"type": "Line",
			"value": " after the `=` and stays whole; one that does not falls through to the fluid layout,",
			"start": 200,
			"end": 286,
			"loc": {
				"start": {
					"line": 4,
					"column": 1
				},
				"end": {
					"line": 4,
					"column": 87
				}
			}
		},
		{
			"type": "Line",
			"value": " where the `=` holds its line and the lookup takes the break instead.",
			"start": 288,
			"end": 359,
			"loc": {
				"start": {
					"line": 5,
					"column": 1
				},
				"end": {
					"line": 5,
					"column": 72
				}
			}
		},
		{
			"type": "Line",
			"value": " an identifier root qualifies",
			"start": 400,
			"end": 431,
			"loc": {
				"start": {
					"line": 9,
					"column": 3
				},
				"end": {
					"line": 9,
					"column": 34
				}
			}
		},
		{
			"type": "Line",
			"value": " so does `this`",
			"start": 539,
			"end": 556,
			"loc": {
				"start": {
					"line": 13,
					"column": 3
				},
				"end": {
					"line": 13,
					"column": 20
				}
			}
		},
		{
			"type": "Line",
			"value": " `super` does not - at exactly 100 the whole thing still fits",
			"start": 664,
			"end": 727,
			"loc": {
				"start": {
					"line": 17,
					"column": 3
				},
				"end": {
					"line": 17,
					"column": 66
				}
			}
		},
		{
