	"comments": [
		{
			"type": "Line",
			"value": " Prettier's `isPoorlyBreakableMemberOrCallChain` gives up on a call whose `printMemberChain`",
			"start": 20,
			"end": 114
		},
		{
			"type": "Line",
			"value": " doc is LABELLED `memberChain` - every chain past the cutoff (two groups, or three when the",
			"start": 116,
			"end": 209
		},
		{
			"type": "Line",
			"value": " first two merge on a `this` / factory head). Such a chain takes the fluid layout and",
			"start": 211,
			"end": 298
		},
		{
			"type": "Line",
			"value": " expands itself; a chain within the cutoff breaks after the `=` and stays whole.",
			"start": 300,
			"end": 382
		},
		{
			"type": "Line",
			"value": " 100 - fits",
			"start": 385,
			"end": 398
		},
		{
			"type": "Line",
			"value": " 101 - three groups, `[this, .cccc] [.dddd()] [?.eeee…includes()]`, and no merge: the chain expands",
			"start": 501,
			"end": 602
		},
		{
			"type": "Line",
			"value": " `this` merges the first two groups only when it is a group of its own - within the cutoff",
			"start": 712,
			"end": 804
		},
		{
			"type": "Line",
			"value": " a factory head merges the same way, as does a factory property closing the first group",
			"start": 910,
			"end": 999
		},
		{
			"type": "Line",
			"value": " a call on the base joins the first group: two groups, break after `=`",
			"start": 1208,
			"end": 1280
		},
		{
			"type": "Line",
			"value": " the assignment twin",
			"start": 1386,
			"end": 1408
		}
	],
