	"comments": [
		{
			"type": "Line",
			"value": " A paren pair around an instantiation expression stays when the token after its",
			"start": 20,
			"end": 101
		},
		{
			"type": "Line",
			"value": " closing `>` unsettles the type arguments, and WHICH parser says so splits four",
			"start": 103,
			"end": 184
		},
		{
			"type": "Line",
			"value": " ways: `+` and `-` read as unary operators to both (`fn < T > +1`); a `>`-led `>`,",
			"start": 186,
			"end": 270
		},
		{
			"type": "Line",
			"value": " `>>` or `>>>` is ambiguous with a re-scanned `>>` to both; `<` and `>=` only tsc",
			"start": 272,
			"end": 355
		},
		{
			"type": "Line",
			"value": " refuses; and `<<` only acorn-typescript, tsv's parse oracle.",
			"start": 357,
			"end": 420
		},
		{
			"type": "Line",
			"value": " A non-null assertion cannot follow a type argument list, so the pair stays here too.",
			"start": 648,
			"end": 735
		},
		{
			"type": "Line",
			"value": " The pair wraps whatever operand ENDS on the close: a binary whose right operand is",
			"start": 808,
			"end": 893
		},
		{
			"type": "Line",
			"value": " an instantiation, a prefix operator's argument, or an angle-bracket assertion's",
			"start": 895,
			"end": 977
		},
		{
			"type": "Line",
			"value": " operand, all re-lex the same way.",
			"start": 979,
			"end": 1015
		},
		{
			"type": "Block",
			"value": " c ",
			"start": 1147,
			"end": 1154
		},
		{
			"type": "Line",
			"value": " An inner assertion that takes its own pair ends the operand on a `)`, so the outer",
			"start": 1220,
			"end": 1305
		},
		{
			"type": "Line",
			"value": " one needs none.",
			"start": 1307,
			"end": 1325
		},
		{
			"type": "Line",
			"value": " Every other operator follows a bare instantiation, so the pair strips.",
			"start": 1358,
			"end": 1431
		}
	],
