	"options": null,
	"comments": [
		{
			"type": "Line",
			"value": " A pair around an instantiation expression stays ahead of `as` and `satisfies`. To",
			"start": 20,
			"end": 104
		},
		{
			"type": "Line",
			"value": " acorn-typescript a word after the closing `>` continues a comparison, so bare, the",
			"start": 106,
			"end": 191
		},
		{
			"type": "Line",
			"value": " line either does not parse (`f<T> as T`) or reads as a different program",
			"start": 193,
			"end": 268
		},
		{
			"type": "Line",
			"value": " (`f<T> as [T]` is `f < T > as[T]`); tsc reads both as the assertion.",
			"start": 270,
			"end": 341
		},
		{
			"type": "Line",
			"value": " The pair wraps whatever operand ENDS on the close: a prefix operator's argument",
			"start": 562,
			"end": 644
		},
		{
			"type": "Line",
			"value": " re-lexes the same way, and a pair written around the instantiation alone moves out",
			"start": 646,
			"end": 731
		},
		{
			"type": "Line",
			"value": " to it (a binary operand of `as` takes its pair in both formatters already).",
			"start": 733,
			"end": 811
		},
		{
			"type": "Line",
			"value": " An operand that does not end on the close prints bare in both formatters.",
			"start": 887,
			"end": 963
		}
	],
