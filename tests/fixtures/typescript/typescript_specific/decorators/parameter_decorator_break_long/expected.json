	"comments": [
		{
			"type": "Line",
			"value": " Once the parameter list breaks, a decorator and its binding are one group",
			"start": 20,
			"end": 96
		},
		{
			"type": "Line",
			"value": " joined by a `line`: the decorator keeps the binding's line while the pair",
			"start": 98,
			"end": 174
		},
		{
			"type": "Line",
			"value": " fits, and drops to its own line when it does not.",
			"start": 176,
			"end": 228
		},
		{
			"type": "Line",
			"value": " The pair is exactly 100 wide, so the decorator stays on the binding's line",
			"start": 250,
			"end": 327
		},
		{
			"type": "Line",
			"value": " One char more and the pair breaks — the decorator takes its own line",
			"start": 455,
			"end": 526
		},
		{
			"type": "Line",
			"value": " A sole parameter: the decorator's own line, then the object expands",
			"start": 661,
			"end": 731
		},
		{
			"type": "Line",
			"value": " A parameter property takes the same group",
			"start": 906,
			"end": 950
		}
	],
