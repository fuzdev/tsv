	"options": null,
	"comments": [
		{
			"type": "Line",
			"value": " A decorated sole parameter never hugs: prettier's `hasNotParameterDecorator`",
			"start": 20,
			"end": 99
		},
		{
			"type": "Line",
			"value": " declines the hug for ANY decorator, so the parameter list breaks around it",
			"start": 101,
			"end": 178
		},
		{
			"type": "Line",
			"value": " instead of welding `(@dec a: {` to the signature.",
			"start": 180,
			"end": 232
		},
		{
			"type": "Line",
			"value": " 100 chars stays inline, 101 breaks the list",
			"start": 254,
			"end": 300
		},
		{
			"type": "Line",
			"value": " An undecorated sole parameter still hugs",
			"start": 510,
			"end": 553
		},
		{
			"type": "Line",
			"value": " Patterns decline the hug too",
			"start": 679,
			"end": 710
		},
		{
			"type": "Line",
			"value": " Any decorator in the list declines it",
			"start": 929,
			"end": 969
		}
	],
