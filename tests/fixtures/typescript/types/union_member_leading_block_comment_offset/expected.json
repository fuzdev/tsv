			"type": "Line",
			"value": " Prettier prints a union member's LEADING comments INSIDE that member's own",
			"start": 20,
			"end": 97
		},
		{
			"type": "Line",
			"value": " `align(2)` offset, so an indentable block's reindented continuation lines sit two",
			"start": 99,
			"end": 183
		},
		{
			"type": "Line",
			"value": " columns past the `|`. A comment TRAILING the previous member prints OUTSIDE the",
			"start": 185,
			"end": 267
		},
