	"comments": [
		{
			"type": "Line",
			"value": " Prettier's `isComplexTypeAliasParams` - two or more type parameters, at least one",
			"start": 20,
			"end": 104
		},
		{
			"type": "Line",
			"value": " constrained or defaulted - takes `break-lhs`: the `<...>` list breaks, the `=` stays on",
			"start": 106,
			"end": 196
		},
		{
			"type": "Line",
			"value": " the closing `>` line, and the value rides beside it. The list breaks only once the head",
			"start": 198,
			"end": 288
		},
		{
			"type": "Line",
			"value": " plus the value's first line - up to its own first break point - overflows. Asked AHEAD",
			"start": 290,
			"end": 379
		},
		{
			"type": "Line",
			"value": " of the value-shaped layouts (the intersection's fluid marker, a reference's hug) and",
			"start": 381,
			"end": 468
		},
		{
			"type": "Line",
			"value": " only BEHIND the break-after-operator ones (a non-hugging union, a conditional with",
			"start": 470,
			"end": 555
		},
		{
			"type": "Line",
			"value": " generic halves).",
			"start": 557,
			"end": 576
		},
		{
			"type": "Line",
			"value": " 100 - the head reaches the first member's `<` exactly at the width: the list stays flat",
			"start": 579,
			"end": 669
		},
		{
			"type": "Line",
			"value": " 101 - one column more and the list breaks; the value rides the `>` line",
			"start": 797,
			"end": 871
		},
		{
			"type": "Line",
			"value": " a type reference, a conditional with plain halves and an object literal do the same",
			"start": 998,
			"end": 1084
		},
		{
			"type": "Line",
			"value": " break-after-operator still wins ahead of it: a union, a conditional with a generic check",
			"start": 1441,
			"end": 1532
		},
		{
			"type": "Line",
			"value": " one parameter is never complex, however constrained: the value breaks after `=` instead",
			"start": 1769,
			"end": 1859
		}
	],
