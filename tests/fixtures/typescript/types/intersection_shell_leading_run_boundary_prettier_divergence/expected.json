			"start": 807,
			"end": 813
		},
		{
			"type": "Line",
			"value": " control: a BARE inner, whose shell run the enclosing `=` gap claims instead —",
			"start": 822,
			"end": 902
		},
		{
			"type": "Line",
			"value": " the same layout by a different route, which is what makes the two agree",
			"start": 904,
			"end": 978
		},
		{
			"type": "Line",
			"value": " c13",
			"start": 989,
			"end": 995
		},
		{
			"type": "Line",
			"value": " c14",
			"start": 1002,
			"end": 1008
		},
		{
			"type": "Line",
			"value": " c15",
			"start": 1012,
			"end": 1018
		},
		{
			"type": "Line",
			"value": " A LATER member's shell leading run ends a line, so its boundary opens and",
			"start": 1027,
			"end": 1103
		},
		{
			"type": "Line",
			"value": " indents even where object-adjacency would otherwise hug — prettier's",
			"start": 1105,
			"end": 1176
		},
		{
			"type": "Line",
			"value": " `hasLeadingOwnLineComment(node)`, asked over the shell region the between-members",
			"start": 1178,
			"end": 1262
		},
		{
			"type": "Line",
			"value": " window cannot see",
			"start": 1264,
			"end": 1284
		},
		{
			"type": "Line",
			"value": " c16",
			"start": 1301,
			"end": 1307
		},
		{
			"type": "Line",
			"value": " c17",
			"start": 1321,
			"end": 1327
		},
		{
			"type": "Line",
			"value": " c18",
			"start": 1330,
			"end": 1336
		},
		{
			"type": "Line",
			"value": " the single-comment spelling of the same shell",
			"start": 1344,
			"end": 1392
		},
		{
			"type": "Line",
			"value": " c19",
			"start": 1409,
			"end": 1415
		},
		{
			"type": "Line",
			"value": " c20",
			"start": 1432,
			"end": 1438
		},
		{
			"type": "Line",
			"value": " and with an object on both sides of the boundary",
			"start": 1441,
			"end": 1492
		},
		{
			"type": "Line",
			"value": " c21",
			"start": 1516,
			"end": 1522
		},
		{
			"type": "Line",
			"value": " c22",
			"start": 1536,
			"end": 1542
		},
		{
			"type": "Line",
			"value": " c23",
			"start": 1545,
			"end": 1551
		},
		{
			"type": "Line",
			"value": " the disjunct is about the LEADING run alone: a shell with no trailing run at all",
			"start": 1558,
			"end": 1641
		},
		{
			"type": "Line",
			"value": " opens its boundary just the same",
			"start": 1643,
			"end": 1678
		},
		{
			"type": "Line",
			"value": " c24",
			"start": 1695,
			"end": 1701
		},
		{
			"type": "Line",
			"value": " and a block-led run does not — a block ends no line, so nothing is relocated",
			"start": 1720,
			"end": 1799
		},
		{
			"type": "Block",
			"value": " c25 ",
			"start": 1814,
			"end": 1823
		},
		{
			"type": "Line",
			"value": " Both rules are asked at the FORCED-MULTILINE loop too — an isolated comment in some",
			"start": 1839,
			"end": 1925
		},
		{
			"type": "Line",
			"value": " other gap routes there, and a boundary rule held at one loop only lets one authoring",
			"start": 1927,
			"end": 2014
		},
		{
			"type": "Line",
			"value": " reach two fixed points depending on what an unrelated gap happens to carry.",
			"start": 2016,
			"end": 2094
		},
		{
			"type": "Line",
			"value": " The first member's hold, and the hoisted run's own indent under that layout:",
			"start": 2096,
			"end": 2175
		},
		{
			"type": "Line",
			"value": " c26",
			"start": 2186,
			"end": 2192
		},
		{
			"type": "Line",
