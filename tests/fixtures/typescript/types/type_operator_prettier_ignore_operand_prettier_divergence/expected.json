			"value": " prettier-ignore ",
			"start": 1880,
			"end": 1901
		},
		{
			"type": "Line",
			"value": " A directive the author put on the keyword's line is INERT under the placement",
			"start": 1918,
			"end": 1998
		},
		{
			"type": "Line",
			"value": " floor: the comment keeps the line it was written on and the operand normalizes.",
			"start": 2000,
			"end": 2082
		},
		{
			"type": "Line",
