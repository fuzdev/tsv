			"value": " 100 chars - stays inline",
			"start": 269,
			"end": 296
		},
		{
			"type": "Line",
			"value": " the `(` at 100 chars - the arguments break",
			"start": 399,
			"end": 444
		},
		{
			"type": "Line",
			"value": " the `(` at 101 chars - breaks after the `=`",
			"start": 558,
			"end": 604
		},
		{
			"type": "Line",
			"value": " the members in any order, `void` like `null`, and a reference with its own type arguments",
			"start": 825,
			"end": 917
		},
		{
			"type": "Line",
			"value": " a `new` expression",
			"start": 1356,
			"end": 1377
		},
		{
			"type": "Line",
			"value": " a type alias: 100 chars stays inline, 101 breaks after the `=`",
			"start": 1483,
			"end": 1548
		},
		{
			"type": "Line",
			"value": " an arrow's return type, in an assignment",
			"start": 1857,
			"end": 1900
		},
		{
			"type": "Line",
			"value": " a return type after a parameter list that can break: the parameters break",
