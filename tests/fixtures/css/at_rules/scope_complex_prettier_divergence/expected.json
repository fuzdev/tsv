		"content": {
			"start": 7,
			"end": 1097,
			"styles": "\n\t/* Basic scoping */\n\t@scope (.card) {\n\t\timg {\n\t\t\tborder: 1px solid;\n\t\t}\n\t}\n\n\t/* Scope with limit */\n\t@scope (.card) to (.ignore) {\n\t\tp {\n\t\t\tcolor: blue;\n\t\t}\n\t}\n\n\t/* Named scope root */\n\t@scope (#header) {\n\t\th1 {\n\t\t\tfont-size: 2rem;\n\t\t}\n\t}\n\n\t/* Scope with multiple selectors */\n\t@scope (.card, .panel) {\n\t\t.title {\n\t\t\tfont-weight: bold;\n\t\t}\n\t}\n\n\t/* Scope with complex limit */\n\t@scope (.container) to (.skip, .exclude) {\n\t\ta {\n\t\t\ttext-decoration: underline;\n\t\t}\n\t}\n\n\t/* Nested scopes */\n\t@scope (.outer) {\n\t\t.outer-content {\n\t\t\tpadding: 1rem;\n\t\t}\n\n\t\t@scope (.inner) {\n\t\t\tspan {\n\t\t\t\tfont-weight: bold;\n\t\t\t}\n\t\t}\n\t}\n\n\t/* Scope with descendant selectors */\n\t@scope (article > header) {\n\t\th2 {\n\t\t\tmargin: 0;\n\t\t}\n\t}\n\n\t/* Scope with pseudo-class */\n\t@scope (.widget:hover) {\n\t\t.tooltip {\n\t\t\tdisplay: block;\n\t\t}\n\t}\n\n\t/* Scope with limit and nested rules */\n\t@scope (.main) to (.footer) {\n\t\tsection {\n\t\t\tmargin-bottom: 2rem;\n\t\t}\n\n\t\tnav {\n\t\t\tposition: sticky;\n\t\t}\n\t}\n\n\t/* Scope with attribute selector */\n\t@scope ([data-theme='dark']) {\n\t\t.background {\n\t\t\tbackground: black;\n\t\t\tcolor: white;\n\t\t}\n\t}\n",
			"comment": null
		}
	},
