			{
				"type": "CSSComment",
				"value": " every operator binds its operand to the RIGHT, so one with nothing after it is the\n\tcondition's own last word: it is kept, and it takes no separator ",
				"start": 9,
				"end": 163
			},
			{
				"type": "CSSComment",
				"value": " the whole run is kept, in source order and source case ",
				"start": 261,
				"end": 321
			},
