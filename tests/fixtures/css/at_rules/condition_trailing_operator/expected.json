				"value": " c ",
				"start": 405,
				"end": 412,
				"position": 11
			},
			{
				"type": "CSSComment",
				"value": " inside a group the same word has no operand either, so it takes no space before `)` ",
				"start": 416,
				"end": 505
			},
			{
				"type": "CSSComment",
				"value": " control: an operator that joins two operands keeps its separator ",
				"start": 572,
