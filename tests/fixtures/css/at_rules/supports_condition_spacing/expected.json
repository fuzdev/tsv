			{
				"type": "CSSComment",
				"value": " A value spelled `and` is a value keyword, not a boolean operator ",
				"start": 9,
				"end": 79
			},
			{
				"type": "CSSComment",
				"value": " A boolean operator between two nested conditions does space ",
				"start": 144,
				"end": 209
			},
			{
				"type": "CSSComment",
				"value": " The space after `:` is decided by the property name, past the comment ",
