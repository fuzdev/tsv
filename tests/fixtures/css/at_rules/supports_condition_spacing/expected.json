			}
		],
		"content": {
			"start": 7,
			"end": 626,
			"styles": "\n\t/* A value spelled `and` is a value keyword, not a boolean operator */\n\t@supports (font-family: and) {\n\t\tdiv {\n\t\t\tcolor: red;\n\t\t}\n\t}\n\n\t/* A boolean operator between two nested conditions does space */\n\t@supports ((display: grid) and (color: red)) {\n\t\tdiv {\n\t\t\tcolor: red;\n\t\t}\n\t}\n\n\t@supports (not (display: grid)) {\n\t\tdiv {\n\t\t\tcolor: red;\n\t\t}\n\t}\n\n\t/* The space after `:` is decided by the property name, past the comment */\n\t@supports (display /* c */: grid) {\n\t\tdiv {\n\t\t\tcolor: red;\n\t\t}\n\t}\n\n\t/* A connector after a selector() part */\n\t@supports selector(div:hover) and (display: grid) {\n\t\tdiv {\n\t\t\tcolor: red;\n\t\t}\n\t}\n",
			"comment": null
		}
