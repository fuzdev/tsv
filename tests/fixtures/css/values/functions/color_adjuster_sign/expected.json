		"comments": [
			{
				"type": "CSSComment",
				"value": " a head `-` the author spaced from a number or a hex keeps its gap inside a\n\t\tcolour-adjuster function — prettier's own list of names, matched\n\t\tcase-insensitively against the function the group belongs to ",
				"start": 17,
