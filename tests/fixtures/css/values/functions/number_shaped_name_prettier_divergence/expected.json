				"end": 259
			},
			{
				"type": "CSSComment",
				"value": " the number is the name, so tsv emits the author's spelling of it ",
				"start": 322,
				"end": 392
			},
			{
				"type": "CSSComment",
				"value": " controls: a word the number production does not match is a name on both sides,\n\t\tand an authored gap is a gap on both sides ",
				"start": 423,
				"end": 552
			}
		],
		"content": {
			"start": 7,
			"end": 601,
			"styles": "\n\ta {\n\t\t/* postcss's `splitWord` reads a word matching its own NUMBER production as a\n\t\tnumeric node, never a function name, and then fabricates a gap ahead of the group\n\t\tit synthesizes — tsv reads the whole word as the name and keeps the authoring */\n\t\tb: 50%(1.5);\n\t\tc: 1e5%(1.5);\n\t\td: 1#(1.5);\n\t\te: 1.5(1.5);\n\t\t/* the number is the name, so tsv emits the author's spelling of it */\n\t\tf: .5(1.5);\n\t\tg: 0a(1.5);\n\t\t/* controls: a word the number production does not match is a name on both sides,\n\t\tand an authored gap is a gap on both sides */\n\t\th: a0(1.5);\n\t\ti: a.5(1.5);\n\t\tj: 1.5 (1.5);\n\t}\n",
			"comment": null
		}
