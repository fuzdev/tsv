			{
				"type": "CSSComment",
				"value": " an `@`-word carries its escapes whole — a hex escape's optional whitespace\n\t\tterminator belongs to the escape — and the group after the word is a member of\n\t\tits own, so the member gap stands ",
				"start": 17,
