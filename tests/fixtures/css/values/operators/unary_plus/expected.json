		"comments": [
			{
				"type": "CSSComment",
				"value": " a `+` opening the value welds onto the word after it — the sign is the word's\n\t\town — and a function named that way still normalizes its arguments ",
				"start": 17,
				"end": 169
			},
			{
				"type": "CSSComment",
				"value": " straight after an operator it welds too, across an authored gap or none ",
				"start": 234,
				"end": 311
			},
			{
				"type": "CSSComment",
				"value": " anywhere else the `+` is an operator and takes an operator's gaps: after a\n\t\tmember, at the head of a function's arguments or of a group, and after a comma ",
				"start": 398,
				"end": 559
			},
			{
				"type": "CSSComment",
				"value": " it welds onto a word only: a group, a string and an `@`-word keep it an operator ",
				"start": 627,
				"end": 713
			},
			{
				"type": "CSSComment",
				"value": " a signed number is a number, whatever precedes it ",
				"start": 751,
				"end": 806
			},
			{
				"type": "CSSComment",
				"value": " calc() prints its authored gap either way ",
				"start": 837,
				"end": 884
			}
		],
		"content": {
			"start": 7,
			"end": 908,
			"styles": "\n\tdiv {\n\t\t/* a `+` opening the value welds onto the word after it — the sign is the word's\n\t\town — and a function named that way still normalizes its arguments */\n\t\ta: +a(2.5);\n\t\tb: +a;\n\t\tc: +#FFF;\n\t\td: +a * 1.5;\n\t\te: +a, b;\n\t\t/* straight after an operator it welds too, across an authored gap or none */\n\t\tf: 1.5 / +a(2.5);\n\t\tg: 1.5 * +a;\n\t\th: 1.5 - +a;\n\t\ti: + +a;\n\t\tj: f(1.5 / +a(2.5));\n\t\t/* anywhere else the `+` is an operator and takes an operator's gaps: after a\n\t\tmember, at the head of a function's arguments or of a group, and after a comma */\n\t\tk: 1.5 + a(2.5);\n\t\tl: f(+ a(2.5));\n\t\tm: (+ a);\n\t\tn: f(a, + b);\n\t\t/* it welds onto a word only: a group, a string and an `@`-word keep it an operator */\n\t\to: +(2.5);\n\t\tp: +'x';\n\t\tq: + @a;\n\t\t/* a signed number is a number, whatever precedes it */\n\t\tr: +1.5;\n\t\ts: 1.5 / +2.5;\n\t\t/* calc() prints its authored gap either way */\n\t\tt: calc(+a(2.5));\n\t}\n",
			"comment": null
		}
