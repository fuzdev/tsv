		"comments": [
			{
				"type": "CSSComment",
				"value": " a `--` word with nothing after its two dashes ends at a `/`, and at a `-` that\n\t\tsigns a number, where every other word takes both as content ",
				"start": 17,
				"end": 164
			},
			{
				"type": "CSSComment",
				"value": " the `+` a value's head welds onto that word rides the same extent ",
				"start": 195,
				"end": 266
			},
			{
				"type": "CSSComment",
				"value": " one ident code point after the dashes and the word absorbs both again — the\n\t\tagreement cells on both sides of the weld ",
				"start": 299,
				"end": 424
			}
		],
		"content": {
			"start": 7,
			"end": 490,
			"styles": "\n\tdiv {\n\t\t/* a `--` word with nothing after its two dashes ends at a `/`, and at a `-` that\n\t\tsigns a number, where every other word takes both as content */\n\t\ta: --/2.50;\n\t\tb: ---2.50;\n\t\t/* the `+` a value's head welds onto that word rides the same extent */\n\t\tc: +--/2.50;\n\t\td: +---2.50;\n\t\t/* one ident code point after the dashes and the word absorbs both again — the\n\t\tagreement cells on both sides of the weld */\n\t\te: --a/1.50;\n\t\tf: --a-2.50;\n\t\tg: +--a/1.50;\n\t\th: +--a-2.50;\n\t}\n",
			"comment": null
		}
