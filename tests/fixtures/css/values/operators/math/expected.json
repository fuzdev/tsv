		"comments": [
			{
				"type": "CSSComment",
				"value": " `*` is always spaced, however it was authored ",
				"start": 17,
				"end": 68
			},
			{
				"type": "CSSComment",
				"value": " `+` keeps a glued pair glued, and spaces one whose neighbour is a word ",
				"start": 132,
				"end": 208
			},
			{
				"type": "CSSComment",
				"value": " a run that starts with an ident character absorbs `-`, so `-` never\n\t\topens a gap of its own ",
				"start": 266,
				"end": 364
			},
			{
				"type": "CSSComment",
				"value": " `+` ends the run, so the hex colour before it is a colour and folds;\n\t\t`-` does not, so the same run stays one opaque token ",
				"start": 401,
				"end": 530
			},
			{
				"type": "CSSComment",
				"value": " inside calc() a glued `+` or `-` is kept as authored, where `*` is\n\t\tstill spaced ",
				"start": 568,
				"end": 655
			}
		],
		"content": {
			"start": 7,
			"end": 735,
			"styles": "\n\tdiv {\n\t\t/* `*` is always spaced, however it was authored */\n\t\tmargin: 1.5 * 2.5;\n\t\tpadding: 1.5 * 2.5;\n\t\twidth: aa * bb;\n\t\t/* `+` keeps a glued pair glued, and spaces one whose neighbour is a word */\n\t\theight: 1.5+2.5;\n\t\ttop: 1.5 + 2.5;\n\t\tright: aa + bb;\n\t\t/* a run that starts with an ident character absorbs `-`, so `-` never\n\t\topens a gap of its own */\n\t\tbottom: 1.5-2.5;\n\t\tleft: aa-bb;\n\t\t/* `+` ends the run, so the hex colour before it is a colour and folds;\n\t\t`-` does not, so the same run stays one opaque token */\n\t\tflex: #fff + 5;\n\t\torder: #FFF-5;\n\t\t/* inside calc() a glued `+` or `-` is kept as authored, where `*` is\n\t\tstill spaced */\n\t\tz-index: calc(1.5+2.5);\n\t\tgap: calc(1.5 + 2.5);\n\t\tinset: calc(1.5 * 2.5);\n\t}\n",
			"comment": null
		}
