		"comments": [
			{
				"type": "CSSComment",
				"value": " two adjacent groups are two members of one value, so they take the\n\t\tordinary member gap whether or not the author wrote one ",
				"start": 17,
				"end": 147
			},
			{
				"type": "CSSComment",
				"value": " an operator glued AFTER a group keeps its glue ",
				"start": 197,
				"end": 249
			},
