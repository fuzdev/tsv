				"value": " `*` is spaced beside a group as it is anywhere else ",
				"start": 273,
				"end": 330
			},
			{
				"type": "CSSComment",
				"value": " the `font` carve-out keeps a glued `/` before a group, so prettier's own\n\t\toutput holds the glue this shape otherwise loses ",
				"start": 355,
				"end": 484
			}
		],
		"content": {
			"start": 7,
			"end": 507,
			"styles": "\n\tdiv {\n\t\t/* two adjacent groups are two members of one value, so they take the\n\t\tordinary member gap whether or not the author wrote one */\n\t\tmargin: (1.5) (2.5);\n\t\tpadding: (1.5) (2.5);\n\t\t/* an operator glued AFTER a group keeps its glue */\n\t\theight: (1.5)/2.5;\n\t\t/* `*` is spaced beside a group as it is anywhere else */\n\t\twidth: 1.5 * (2.5);\n\t\t/* the `font` carve-out keeps a glued `/` before a group, so prettier's own\n\t\toutput holds the glue this shape otherwise loses */\n\t\tfont: 1.5/(2.5);\n\t}\n",
			"comment": null
		}
	},
