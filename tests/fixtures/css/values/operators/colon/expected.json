			"styles": "\n\tdiv {\n\t\t/* a `:` inside a function or a group is its own token: it never takes a\n\t\tspace before and always takes one after */\n\t\tmargin: f(a: 1.5);\n\t\tpadding: f(a: 1.5);\n\t\twidth: f(a: 1.5);\n\t\theight: (a: 1.5);\n\t\ttop: f(1.5: 2.5);\n\t\tright: f(a: 1.5, b: 2.5);\n\t\t/* a url() argument is opaque, so its `:` is content */\n\t\tbottom: url(a:1.50);\n\t}\n",
