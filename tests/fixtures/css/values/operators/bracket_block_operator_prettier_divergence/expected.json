		"comments": [
			{
				"type": "CSSComment",
				"value": " a `[…]` block is word text, not a value to descend into, so it is kept exactly\n\t\tas written — an operator byte inside it is content like any other ",
				"start": 17,
				"end": 169
			},
			{
				"type": "CSSComment",
				"value": " the cells that bound it: a block whose content is not an operator byte ",
				"start": 303,
				"end": 379
			},
			{
				"type": "CSSComment",
				"value": " prettier's space lands at every word boundary its tokenizer finds: the one gap it\n\t\tmisses is the one before a group's LAST node, so a block that ends the value reads\n\t\t`[ *]` where one with a member after it reads `[ * ]` ",
				"start": 459,
				"end": 687
			},
			{
				"type": "CSSComment",
				"value": " the tokenizer ends a word at a `:` as well, wherever a `:` is a value token at\n\t\tall — inside a function's arguments, and at a custom property's top level ",
				"start": 706,
				"end": 866
			}
		],
		"content": {
			"start": 7,
			"end": 920,
			"styles": "\n\tdiv {\n\t\t/* a `[…]` block is word text, not a value to descend into, so it is kept exactly\n\t\tas written — an operator byte inside it is content like any other */\n\t\ta: --modifier(2.5, [*]);\n\t\tb: f(2.5, [*]);\n\t\tc: [*];\n\t\td: f(2.5, [*a]);\n\t\te: f(2.5, [a*]);\n\t\tf: f(2.5, [+]);\n\t\tg: f(2.5, [*b*]);\n\t\t/* the cells that bound it: a block whose content is not an operator byte */\n\t\th: f(2.5, [a]);\n\t\ti: f(2.5, [1.50]);\n\t\tj: f(2.5, [a-b]);\n\t\tk: f(2.5, [/]);\n\t\t/* prettier's space lands at every word boundary its tokenizer finds: the one gap it\n\t\tmisses is the one before a group's LAST node, so a block that ends the value reads\n\t\t`[ *]` where one with a member after it reads `[ * ]` */\n\t\tl: a[*](2.5);\n\t\t/* the tokenizer ends a word at a `:` as well, wherever a `:` is a value token at\n\t\tall — inside a function's arguments, and at a custom property's top level */\n\t\tm: f(2.5, [a:b]);\n\t\t--n: [a:b];\n\t\t--o: a[b:c]d;\n\t}\n",
			"comment": null
		}
