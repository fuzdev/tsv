			"styles": "\n\t.card {\n\t\tpadding: 1rem;\n\n\t\t/* Modern pseudo-class in nesting */\n\t\t&:user-valid {\n\t\t\tborder-color: green;\n\t\t}\n\n\t\t/* Modern pseudo-element in nesting */\n\t\t&::highlight(search) {\n\t\t\tbackground: yellow;\n\t\t}\n\n\t\t/* At-rule nesting with modern features */\n\t\t@media (width >= 768px) {\n\t\t\t& > .title {\n\t\t\t\tfont-size: 2rem;\n\t\t\t}\n\t\t}\n\t}\n",
