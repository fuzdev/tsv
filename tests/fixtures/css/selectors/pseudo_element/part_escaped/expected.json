		"comments": [
			{
				"type": "CSSComment",
				"value": " a part name is an ident, so its escapes stay verbatim: an escaped space is inside the one\n\t   name `name1 name2`, not a separator between two names ",
				"start": 9,
				"end": 162
			},
			{
				"type": "CSSComment",
				"value": " a hex escape and its terminator whitespace are one code point, `A` ",
				"start": 206,
				"end": 278
			},
			{
				"type": "CSSComment",
				"value": " an escaped newline code point (`\\a`) is content of the name, never a raw line break ",
				"start": 320,
				"end": 409
			}
		],
		"content": {
			"start": 7,
			"end": 448,
			"styles": "\n\t/* a part name is an ident, so its escapes stay verbatim: an escaped space is inside the one\n\t   name `name1 name2`, not a separator between two names */\n\t::part(name1\\ name2) {\n\t\tcolor: red;\n\t}\n\n\t/* a hex escape and its terminator whitespace are one code point, `A` */\n\t::part(\\41 name3) {\n\t\tcolor: blue;\n\t}\n\n\t/* an escaped newline code point (`\\a`) is content of the name, never a raw line break */\n\t::part(name4\\a) {\n\t\tcolor: green;\n\t}\n",
			"comment": null
		}
	},
