			{
				"type": "CSSComment",
				"value": " bare number and An+B — the pseudo-arg Nth production ",
				"start": 9,
				"end": 67
			},
			{
				"type": "CSSComment",
				"value": " descendant and child combinators — a full complex selector ",
				"start": 143,
				"end": 207
			},
			{
				"type": "CSSComment",
				"value": " universal with a combinator ",
				"start": 312,
				"end": 345
			},
