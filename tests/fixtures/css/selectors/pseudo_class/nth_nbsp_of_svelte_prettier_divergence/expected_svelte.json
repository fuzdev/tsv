		"comments": [
			{
				"type": "CSSComment",
				"value": " U+00A0 after the `of` keyword is the separator before S; it stays, flush against S ",
				"start": 9,
				"end": 97
			},
			{
				"type": "CSSComment",
				"value": " ...and before it, flush against the An+B term, with the keyword's own space after it ",
				"start": 150,
				"end": 240
			},
			{
				"type": "CSSComment",
				"value": " after S, before the `)`, behind the space that closes the last name ",
				"start": 295,
				"end": 368
			},
			{
				"type": "CSSComment",
				"value": " the same fold in a non-nth functional pseudo, where ` of ` stays inside the Nth value ",
				"start": 425,
				"end": 516
			}
		],
		"content": {
			"start": 7,
			"end": 561,
			"styles": "\n\t/* U+00A0 after the `of` keyword is the separator before S; it stays, flush against S */\n\t:nth-child(2n + 1 of .class1) {\n\t\tcolor: red;\n\t}\n\n\t/* ...and before it, flush against the An+B term, with the keyword's own space after it */\n\t:nth-child(2n + 1  of .class2) {\n\t\tcolor: blue;\n\t}\n\n\t/* after S, before the `)`, behind the space that closes the last name */\n\t:nth-child(2n + 1 of .class3  ) {\n\t\tcolor: green;\n\t}\n\n\t/* the same fold in a non-nth functional pseudo, where ` of ` stays inside the Nth value */\n\t:is(2n + 1 of .class4) {\n\t\tcolor: teal;\n\t}\n",
			"comment": null
		}
	},
