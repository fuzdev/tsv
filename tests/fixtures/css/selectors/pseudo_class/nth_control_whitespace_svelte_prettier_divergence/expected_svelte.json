		"comments": [
			{
				"type": "CSSComment",
				"value": " A control character Svelte's `\\s` counts as whitespace (VT U+000B, FF U+000C) around an\n\t   An+B operator normalizes to a single space, like every other selector gap ",
				"start": 9,
				"end": 180
			},
			{
				"type": "CSSComment",
				"value": " ...and around the `of` keyword ",
				"start": 222,
				"end": 258
			},
			{
				"type": "CSSComment",
				"value": " ...and inside the parens, before the term and after it, where it is dropped ",
				"start": 312,
				"end": 393
			},
			{
				"type": "CSSComment",
				"value": " the same term in a non-nth functional pseudo ",
				"start": 437,
				"end": 487
			}
		],
		"content": {
			"start": 7,
			"end": 521,
			"styles": "\n\t/* A control character Svelte's `\\s` counts as whitespace (VT U+000B, FF U+000C) around an\n\t   An+B operator normalizes to a single space, like every other selector gap */\n\t:nth-child(2n + 1) {\n\t\tcolor: red;\n\t}\n\n\t/* ...and around the `of` keyword */\n\t:nth-child(2n + 1 of .class1) {\n\t\tcolor: blue;\n\t}\n\n\t/* ...and inside the parens, before the term and after it, where it is dropped */\n\t:nth-child(2n + 1) {\n\t\tcolor: green;\n\t}\n\n\t/* the same term in a non-nth functional pseudo */\n\t:is(2n + 1) {\n\t\tcolor: teal;\n\t}\n",
			"comment": null
		}
	},
