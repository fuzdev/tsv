		"comments": [
			{
				"type": "CSSComment",
				"value": " a non-selector argument of an unknown functional pseudo-class is kept ",
				"start": 9,
				"end": 84
			},
			{
				"type": "CSSComment",
				"value": " glued operators stay glued: spacing them would change the tokens ",
				"start": 120,
				"end": 190
			},
			{
				"type": "CSSComment",
				"value": " a pseudo-element takes the same argument ",
				"start": 232,
				"end": 278
			},
			{
				"type": "CSSComment",
				"value": " strings, commas, nested blocks and functions ",
				"start": 315,
				"end": 365
			},
			{
				"type": "CSSComment",
				"value": " a top-level semicolon and bang are argument content ",
				"start": 493,
				"end": 550
			},
			{
				"type": "CSSComment",
				"value": " a comment inside the argument is kept ",
				"start": 586,
				"end": 629
			},
			{
				"type": "CSSComment",
				"value": " c ",
				"start": 639,
				"end": 646
			},
			{
				"type": "CSSComment",
				"value": " numbers, units and hash tokens are kept as written ",
				"start": 671,
				"end": 727
			},
			{
				"type": "CSSComment",
				"value": " a non-ASCII space is an identifier code point, so the argument is not empty ",
				"start": 780,
				"end": 861
			},
			{
				"type": "CSSComment",
				"value": " the selector continues after the argument ",
				"start": 893,
				"end": 940
			}
		],
		"content": {
			"start": 7,
			"end": 1047,
			"styles": "\n\t/* a non-selector argument of an unknown functional pseudo-class is kept */\n\ta:foo(1 + 2) {\n\t\tcolor: red;\n\t}\n\n\t/* glued operators stay glued: spacing them would change the tokens */\n\ta:foo(1+2 1>2 1~2) {\n\t\tcolor: red;\n\t}\n\n\t/* a pseudo-element takes the same argument */\n\ta::foo(1 + 2) {\n\t\tcolor: red;\n\t}\n\n\t/* strings, commas, nested blocks and functions */\n\ta:foo('x', 1 + 2) {\n\t\tcolor: red;\n\t}\n\n\ta:foo((1 + 2) * 3 [1] {2}) {\n\t\tcolor: red;\n\t}\n\n\ta:foo(f(1 2) g()) {\n\t\tcolor: red;\n\t}\n\n\t/* a top-level semicolon and bang are argument content */\n\ta:foo(1;2 !) {\n\t\tcolor: red;\n\t}\n\n\t/* a comment inside the argument is kept */\n\ta:foo(1 /* c */ 2) {\n\t\tcolor: red;\n\t}\n\n\t/* numbers, units and hash tokens are kept as written */\n\ta:foo(.50em + #FFF 1.0 a\\ .5) {\n\t\tcolor: red;\n\t}\n\n\t/* a non-ASCII space is an identifier code point, so the argument is not empty */\n\ta:foo( ) {\n\t\tcolor: red;\n\t}\n\n\t/* the selector continues after the argument */\n\ta:foo(1 + 2):hover b {\n\t\tcolor: red;\n\t}\n\n\t@supports selector(a:foo(1 + 2)) {\n\t\ta {\n\t\t\tcolor: red;\n\t\t}\n\t}\n",
			"comment": null
		}
	},
