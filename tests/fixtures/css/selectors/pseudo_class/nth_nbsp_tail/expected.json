			{
				"type": "CSSComment",
				"value": " U+00A0 between the An+B term and the `)` is a boundary run the parser skips;\n\t   it is kept flush against the `)` ",
				"start": 9,
				"end": 128
			},
			{
				"type": "CSSComment",
				"value": " a keyword term takes the same tail ",
				"start": 171,
				"end": 211
			},
			{
				"type": "CSSComment",
				"value": " both sides of the term at once ",
				"start": 253,
