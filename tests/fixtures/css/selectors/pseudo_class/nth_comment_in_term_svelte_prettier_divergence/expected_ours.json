		"comments": [
			{
				"type": "CSSComment",
				"value": " A comment splits the An+B term: inter-token trivia per CSS Syntax 3, so the term\n\t   still reads as one Nth and the gaps around the comment normalize to one space. ",
				"start": 9,
				"end": 178
			},
			{
				"type": "CSSComment",
				"value": " the term's other interior gap: between the sign and the signless integer ",
				"start": 230,
				"end": 308
			},
			{
				"type": "CSSComment",
				"value": " a run of comments in one gap ",
				"start": 361,
				"end": 395
			},
			{
				"type": "CSSComment",
				"value": " composes with the spec-only negative forms ",
				"start": 458,
				"end": 506
			},
			{
				"type": "CSSComment",
				"value": " a bare n also has a type-selector reading, so this is the term the selector-list\n\t   fallback would silently accept instead - it must read as one Nth like the rest ",
				"start": 560,
				"end": 729
			},
			{
				"type": "CSSComment",
				"value": " operator characters inside the comment content are never respaced ",
				"start": 783,
				"end": 854
			},
			{
				"type": "CSSComment",
				"value": " composes with of S ",
				"start": 910,
				"end": 934
			},
			{
				"type": "CSSComment",
				"value": " even and odd take no tail, so this is not an An+B term at all: it stays demoted to\n\t   the selector-list path (a type selector, a combinator and a bare Nth) ",
				"start": 997,
				"end": 1159
			},
			{
				"type": "CSSComment",
				"value": " c8 ",
				"start": 1178,
				"end": 1186
			}
		],
		"content": {
			"start": 7,
			"end": 1213,
			"styles": "\n\t/* A comment splits the An+B term: inter-token trivia per CSS Syntax 3, so the term\n\t   still reads as one Nth and the gaps around the comment normalize to one space. */\n\ta:nth-child(2n /* c1 */ + 1) {\n\t\tcolor: red;\n\t}\n\n\t/* the term's other interior gap: between the sign and the signless integer */\n\ta:nth-child(2n + /* c2 */ 1) {\n\t\tcolor: blue;\n\t}\n\n\t/* a run of comments in one gap */\n\ta:nth-child(2n /* c3 */ /* c4 */ + 1) {\n\t\tcolor: green;\n\t}\n\n\t/* composes with the spec-only negative forms */\n\ta:nth-child(-2n /* c5 */ - 3) {\n\t\tcolor: teal;\n\t}\n\n\t/* a bare n also has a type-selector reading, so this is the term the selector-list\n\t   fallback would silently accept instead - it must read as one Nth like the rest */\n\ta:nth-child(n /* c6 */ + 1) {\n\t\tcolor: purple;\n\t}\n\n\t/* operator characters inside the comment content are never respaced */\n\ta:nth-child(2n /* a+b */ + 1) {\n\t\tcolor: orange;\n\t}\n\n\t/* composes with of S */\n\ta:nth-child(2n /* c7 */ + 1 of .class) {\n\t\tcolor: navy;\n\t}\n\n\t/* even and odd take no tail, so this is not an An+B term at all: it stays demoted to\n\t   the selector-list path (a type selector, a combinator and a bare Nth) */\n\ta:nth-child(even /* c8 */ + 1) {\n\t\tcolor: olive;\n\t}\n",
			"comment": null
		}
	},
