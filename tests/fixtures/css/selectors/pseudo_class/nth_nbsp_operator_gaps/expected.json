				"start": 317,
				"end": 367
			}
		],
		"content": {
			"start": 7,
			"end": 403,
			"styles": "\n\t/* U+00A0 on either side of the An+B operator is not whitespace to the respacing:\n\t   the ASCII gaps normalize to one space each and the character stays put */\n\t:nth-child(2n  +  1) {\n\t\tcolor: red;\n\t}\n\n\t/* one side only */\n\t:nth-child(2n  + 1) {\n\t\tcolor: blue;\n\t}\n\t:nth-child(2n +  1) {\n\t\tcolor: green;\n\t}\n\n\t/* the same term in a non-nth functional pseudo */\n\t:is(2n  +  1) {\n\t\tcolor: teal;\n\t}\n",
			"comment": null
		}
