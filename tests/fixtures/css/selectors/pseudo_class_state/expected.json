			"styles": "\n\tinput:checked {\n\t\tbackground: green;\n\t}\n\n\tbutton:disabled {\n\t\topacity: 0.5;\n\t\tcursor: not-allowed;\n\t}\n\n\tinput:enabled {\n\t\tborder-color: blue;\n\t}\n\n\tinput:focus {\n\t\toutline: 2px solid blue;\n\t}\n\n\ta:hover {\n\t\ttext-decoration: underline;\n\t}\n\n\ta:active {\n\t\tcolor: red;\n\t}\n\n\tinput:required {\n\t\tborder-left: 3px solid red;\n\t}\n\n\tinput:optional {\n\t\tborder-left: 3px solid gray;\n\t}\n\n\tinput:user-valid {\n\t\tborder-color: green;\n\t}\n\n\tinput:user-invalid {\n\t\tborder-color: red;\n\t}\n\n\tinput:autofill {\n\t\tbackground: lightyellow;\n\t}\n",
