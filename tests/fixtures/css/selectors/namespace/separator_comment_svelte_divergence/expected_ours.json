		"content": {
			"start": 7,
			"end": 503,
			"styles": "\n\t/* a named prefix, comment on either side of the separator */\n\tsvg/* c1 */|rect {\n\t\tcolor: red;\n\t}\n\n\tsvg|/* c2 */rect {\n\t\tcolor: blue;\n\t}\n\n\t/* the universal prefix */\n\t*/* c3 */|div {\n\t\tcolor: green;\n\t}\n\n\t*|/* c4 */div {\n\t\tcolor: teal;\n\t}\n\n\t/* the explicit no-namespace prefix, with a type selector and with the universal */\n\t|/* c5 */div {\n\t\tcolor: navy;\n\t}\n\n\t|/* c6 */* {\n\t\tcolor: olive;\n\t}\n\n\t/* a `|` inside the comment content is not the separator */\n\tsvg/* | */|rect {\n\t\tcolor: purple;\n\t}\n",
			"comment": null
		}
