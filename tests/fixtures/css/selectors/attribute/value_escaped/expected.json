			"styles": "\n\t/* bare value whose escape encodes a quote stays bare (quoting would need re-escaping) */\n\t[data-attr1=x\\'] {\n\t\tcolor: red;\n\t}\n\n\t[data-attr2=x\\\"] {\n\t\tcolor: blue;\n\t}\n\n\t/* bare value with a hex escape: quoted, escape kept verbatim */\n\t[data-attr3='x\\27'] {\n\t\tcolor: green;\n\t}\n",
