		"content": {
			"start": 7,
			"end": 330,
			"styles": "\n\t/* an identity-escaped `|` belongs to the prefix's NAME, not the <wq-name> separator */\n\t[a\\|b|attr] {\n\t\tcolor: red;\n\t}\n\n\t/* the hex spelling of the same prefix */\n\t[a\\7c b|attr] {\n\t\tcolor: blue;\n\t}\n\n\t/* an ordinary escape in the prefix survives verbatim, like the attribute name's */\n\t[a\\41 b|attr] {\n\t\tcolor: green;\n\t}\n",
			"comment": null
		}
