		"comments": [
			{
				"type": "CSSComment",
				"value": " U+00A0 glued to a bare value stays inside it: one ident to css-syntax, a separator to parseCss ",
				"start": 9,
				"end": 109
			},
			{
				"type": "CSSComment",
				"value": " ...and the case flag glued to the run stays glued ",
				"start": 146,
				"end": 201
			},
			{
				"type": "CSSComment",
				"value": " an ASCII space beside the run is a token separator and is kept, as one space ",
				"start": 240,
				"end": 322
			},
			{
				"type": "CSSComment",
				"value": " after a quoted value the run is its own token; flush against the quote, before the flag ",
				"start": 363,
				"end": 456
			},
			{
				"type": "CSSComment",
				"value": " behind the case flag, where the `]` is due ",
				"start": 536,
				"end": 584
			}
		],
		"content": {
			"start": 7,
			"end": 625,
			"styles": "\n\t/* U+00A0 glued to a bare value stays inside it: one ident to css-syntax, a separator to parseCss */\n\t[attr=value ] {\n\t\tcolor: red;\n\t}\n\n\t/* ...and the case flag glued to the run stays glued */\n\t[attr=value i] {\n\t\tcolor: blue;\n\t}\n\n\t/* an ASCII space beside the run is a token separator and is kept, as one space */\n\t[attr=value  s] {\n\t\tcolor: green;\n\t}\n\n\t/* after a quoted value the run is its own token; flush against the quote, before the flag */\n\t[attr='value' ] {\n\t\tcolor: teal;\n\t}\n\n\t[attr='value'  i] {\n\t\tcolor: gray;\n\t}\n\n\t/* behind the case flag, where the `]` is due */\n\t[attr='value' s ] {\n\t\tcolor: black;\n\t}\n",
			"comment": null
		}
	},
