		"content": {
			"start": 92,
			"end": 468,
			"styles": "\n\t/* each ASCII whitespace stretch in a boundary run prints as one space */\n\tb {\n\t\tcolor: red;\n\t}\n\t﻿ a {\n\t\tcolor: red;\n\t}\n\t  a {\n\t\tcolor: red;\n\t}\n\t   a {\n\t\tcolor: red;\n\t}\n\t﻿ ﻿ a {\n\t\tcolor: red;\n\t}\n\ta,\n\t﻿ b {\n\t\tcolor: red;\n\t}\n\ta > ﻿ b {\n\t\tcolor: red;\n\t}\n\t:is(﻿ b) {\n\t\tcolor: red;\n\t}\n\t﻿ @media screen {\n\t\ta {\n\t\t\tcolor: red;\n\t\t}\n\t}\n\t@media screen {\n\t\t  a {\n\t\t\tcolor: red;\n\t\t}\n\t}\n",
			"comment": null
		}
