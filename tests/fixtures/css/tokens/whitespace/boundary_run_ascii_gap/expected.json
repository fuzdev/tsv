			"styles": "\n\t/* each ASCII whitespace stretch beside a boundary run prints as one space */\n\t:is(a    ) {\n\t\tcolor: red;\n\t}\n\ta    ,\n\tb {\n\t\tcolor: red;\n\t}\n\t::part(a    b) {\n\t\tcolor: red;\n\t}\n\ta ﻿ {\n\t\tcolor: red;\n\t}\n\ta     {\n\t\tcolor: red;\n\t}\n\t:nth-child(2n  ) {\n\t\tcolor: red;\n\t}\n\t:nth-child(2n    ) {\n\t\tcolor: red;\n\t}\n",
