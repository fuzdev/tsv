{
  "name": "tsv",
  "version": "0.0.1",
  "description": "a high-performance Rust parser that's a drop-in replacement for Svelte's modern parser (acorn + acorn-typescript)",
  "homepage": "https://www.tsv.dev/",
  "bugs": {
    "url": "https://github.com/ryanatkn/tsv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanatkn/tsv.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ryan Atkinson",
    "email": "mail@ryanatkn.com",
    "url": "https://www.ryanatkn.com/"
  },
  "type": "module",
  "scripts": {
    "test": "cargo test && cargo clippy && npm run typecheck && prettier . --check && npm run fixtures:check-formatted",
    "typecheck": "tsc",
    "format": "cargo fmt && prettier . --write",
    "fixtures:update-expected": "node tests/scripts/update-expected.js",
    "fixtures:update-formatted": "node tests/scripts/update-formatted.js",
    "fixtures:check-formatted": "node tests/scripts/check-expected.js",
    "fixtures:list": "node tests/scripts/update-expected.js --list",
    "debug:compare": "node tests/debug/compare.js",
    "debug:ast": "node tests/debug/parse-ast.js"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.43.0",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "useTabs": true,
    "printWidth": 100,
    "singleQuote": true,
    "bracketSpacing": false,
    "overrides": [
      {
        "files": "package.json",
        "options": {
          "useTabs": false
        }
      }
    ]
  }
}
