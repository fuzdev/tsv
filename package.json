{
  "name": "tsv",
  "version": "0.0.1",
  "description": "a collection of efficient and effective tools for TypeScript, CSS, HTML, and Svelte",
  "homepage": "https://www.tsv.dev/",
  "bugs": {
    "url": "https://github.com/ryanatkn/tsv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanatkn/tsv.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ryan Atkinson",
    "email": "mail@ryanatkn.com",
    "url": "https://www.ryanatkn.com/"
  },
  "type": "module",
  "scripts": {
    "test": "cargo test && cargo clippy && npm run typecheck && prettier . --check && npm run fixtures_check_formatted",
    "typecheck": "tsc",
    "format": "cargo fmt && prettier . --write",
    "fixtures_update_expected": "cargo run -p tsv_debug --quiet fixtures_update_expected",
    "fixtures_update_formatted": "cargo run -p tsv_debug --quiet fixtures_update_formatted",
    "fixtures_check_formatted": "cargo run -p tsv_debug --quiet fixtures_check_formatted",
    "fixtures_list": "cargo run -p tsv_debug --quiet fixtures_update_expected --list",
    "debug_compare": "cargo run -p tsv_debug --quiet compare"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.43.0",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "useTabs": true,
    "printWidth": 100,
    "singleQuote": true,
    "bracketSpacing": false,
    "overrides": [
      {
        "files": "package.json",
        "options": {
          "useTabs": false
        }
      }
    ]
  },
  "motto": "TypeScript and Svelte tools in Rust"
}
