{
	"compilerOptions": {
		"noEmit": true,
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noImplicitOverride": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": [
		"scripts/roots/**/*.ts",
		"scripts/pgo/pgo.ts",
		"scripts/pgo/addon_ops.ts",
		"scripts/pgo/addon_depth.ts",
		"crates/tsv_debug/sidecar/sidecar.ts",
		"benches/js/roots/divergence_audit.ts",
		"benches/js/roots/corpus_stats.ts",
		"benches/js/roots/compose_reports.ts",
		"benches/js/roots/wasm_format_probe.ts",
		"benches/js/roots/wasm_glue.ts",
		"benches/js/roots/wasm_memory_probe.ts",
		"benches/js/roots/corpus_audit.ts",
		"benches/js/roots/harvest_deps.ts",
		"benches/js/roots/harvest_test262.ts",
		"benches/js/roots/harvest_ts_repo.ts",
		"benches/js/roots/idempotency_sweep.ts",
		"benches/js/roots/svelte_styles_harvest.ts",
		"benches/js/roots/wpt_css_harvest.ts"
	]
}
