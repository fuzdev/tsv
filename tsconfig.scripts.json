{
	"compilerOptions": {
		"noEmit": true,
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noImplicitOverride": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": [
		"scripts/roots/**/*.ts",
		"scripts/pgo/pgo.ts",
		"scripts/pgo/addon_ops.ts",
		"scripts/pgo/addon_depth.ts",
		"crates/tsv_debug/sidecar/sidecar.ts",
		"benches/js/roots/divergence_audit.ts",
		"benches/js/roots/corpus_stats.ts",
		"benches/js/roots/compose_reports.ts"
	]
}
